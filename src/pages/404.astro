---
import BaseLayout from '../layouts/BaseLayout.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';

const pageTitle = 'Página no encontrada | Happy Paws Foresta';
const pageDesc =
  'La página que buscas no existe o cambió de dirección. Vuelve al inicio o escríbenos por WhatsApp.';
---

<BaseLayout title={pageTitle} description={pageDesc} currentPath="/404/" noindex={true}>
  <section class="section-wrapper section-surface notfound">
    <div class="container notfound-container">
      <img
        src="/images/logo-full.png"
        alt="Happy Paws"
        width="220"
        height="140"
        class="notfound-logo"
        loading="eager"
        fetchpriority="high"
      />
      <span class="badge badge-orange">Error 404</span>
      <h1 class="notfound-title">Esta página no existe</h1>
      <p class="notfound-text">
        Puede que el enlace esté mal escrito o que la página haya cambiado de
        dirección. Nuestro servicio sigue disponible: vuelve al inicio para
        conocer los paseos en Foresta Dream Lagoons, o escríbenos por WhatsApp y
        te ayudamos directamente.
      </p>

      <div class="notfound-actions">
        <a href="/" class="btn btn-primary btn-lg">Volver al inicio</a>
        <WhatsAppButton
          context="main"
          text="Escribir por WhatsApp"
          variant="whatsapp"
          size="lg"
        />
      </div>

      <div class="notfound-links">
        <p>O ve directo a lo que buscas:</p>
        <ul>
          <li><a href="/#beneficios">Beneficios para tu mascota</a></li>
          <li><a href="/#como-funciona">Cómo funciona el servicio</a></li>
          <li><a href="/#faq">Preguntas frecuentes</a></li>
          <li><a href="/paseos/">Modalidades: individual y grupal</a></li>
        </ul>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .notfound {
    min-height: 60vh;
    display: flex;
    align-items: center;
  }

  .notfound-container {
    max-width: 640px;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-4);
  }

  .notfound-logo {
    height: auto;
    width: clamp(180px, 40vw, 240px);
    margin-bottom: var(--space-2);
  }

  .notfound-title {
    font-size: clamp(2rem, 4vw, 2.75rem);
    color: var(--color-text-title);
    line-height: 1.2;
  }

  .notfound-text {
    font-size: 1.05rem;
    line-height: 1.7;
    color: var(--color-text-muted);
    max-width: 540px;
  }

  .notfound-actions {
    margin-top: var(--space-4);
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-4);
  }

  .notfound-links {
    margin-top: var(--space-8);
    padding-top: var(--space-8);
    border-top: 1px solid var(--color-border);
    width: 100%;
  }

  .notfound-links p {
    font-size: 0.925rem;
    color: var(--color-text-muted);
    margin-bottom: var(--space-3);
  }

  .notfound-links ul {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-3) var(--space-6);
  }

  .notfound-links a {
    font-size: 0.95rem;
    font-weight: 600;
    /* #EE5D1A sobre blanco da 3.38:1 (FALLA AA para texto de 0.95rem). */
    color: var(--color-primary-text);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  @media (max-width: 640px) {
    .notfound-actions {
      flex-direction: column;
      width: 100%;
    }

    .notfound-actions .btn {
      width: 100%;
    }
  }
</style>
