---
import BaseLayout from '../layouts/BaseLayout.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';
import FAQAccordion from '../components/FAQAccordion.astro';
import PostWalkReport from '../components/PostWalkReport.astro';

const pageTitle = "Happy Paws — Paseos Caninos Exclusivos en Foresta Dream Lagoons";
const pageDesc = "Servicio de paseo y bienestar para perros exclusivo en Foresta Dream Lagoons. Atención dedicada, exploración a su ritmo y reporte directo por WhatsApp.";
---

<BaseLayout title={pageTitle} description={pageDesc} currentPath="/">
  <!-- ================= 1. HERO SECTION (Limpio y directo como Petme) ================= -->
  <section class="hero-clean" id="inicio">
    <div class="container hero-clean-container">
      <div class="hero-clean-content">
        <div class="location-chip">
          <svg class="chip-pin" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
            <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
            <circle cx="12" cy="10" r="3"></circle>
          </svg>
          <span>Exclusivo en Foresta Dream Lagoons</span>
        </div>

        <h1 class="hero-clean-title">
          El paseo que tu perro necesita. <br />
          <span class="text-highlight">La tranquilidad que tú buscas.</span>
        </h1>

        <p class="hero-clean-subtitle">
          Paseos dedicados y seguros dentro de Foresta Dream Lagoons. Atención personalizada, exploración a su ritmo y reporte directo en tu teléfono en cada salida.
        </p>

        <div class="hero-clean-ctas">
          <WhatsAppButton
            context="main"
            text="Quiero conocer el servicio"
            variant="primary"
            size="lg"
            id="hero-primary-cta"
            ariaLabel="Solicitar información de Happy Paws por WhatsApp"
          />
          <a href="#como-funciona" class="btn btn-secondary btn-lg" id="hero-secondary-cta">
            Cómo funciona
          </a>
        </div>

        <div class="hero-clean-trust">
          <div class="trust-point">
            <span class="check-bullet"></span>
            <span>100% dentro del fraccionamiento</span>
          </div>
          <div class="trust-point">
            <span class="check-bullet"></span>
            <span>Atención 1 a 1 o grupos máx. 3-4 perros</span>
          </div>
          <div class="trust-point">
            <span class="check-bullet"></span>
            <span>Reporte al finalizar cada paseo</span>
          </div>
        </div>
      </div>

      <div class="hero-clean-media">
        <div class="hero-frame">
          <img
            src="/images/hero-walk.jpg"
            alt="Perro paseando con correa de forma tranquila en áreas verdes de Foresta Dream Lagoons"
            class="hero-clean-img"
            loading="eager"
            fetchpriority="high"
          />
          <div class="hero-clean-badge">
            <span class="badge-tag">Atención Vecinal</span>
            <span class="badge-title">Senderos y áreas verdes de Foresta</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ================= 2. BENEFICIOS PARA LA MASCOTA (DISEÑO MÁS AMPLIO - Estilo Petme) ================= -->
  <section class="section-wrapper section-surface benefits-expanded-section" id="beneficios">
    <div class="container">
      <div class="section-header">
        <span class="badge badge-orange">Bienestar para tu Mascota</span>
        <h2>Mucho más que una salida: salud física y equilibrio mental</h2>
        <p>
          Inspirado en las verdaderas necesidades biológicas de tu perro. Caminar por las áreas verdes de Foresta reduce el estrés, previene conductas destructivas y le devuelve su calma natural.
        </p>
      </div>

      <!-- Tarjetas Amplias Editoriales de Beneficios -->
      <div class="benefits-wide-grid">
        <!-- Bloque Amplio 1: Estimulación Olfativa -->
        <article class="wide-benefit-card">
          <div class="wide-card-media">
            <img
              src="/images/individual-walk.jpg"
              alt="Perro explorando y oliendo con calma en un paseo individual atento"
              loading="lazy"
            />
          </div>
          <div class="wide-card-content">
            <span class="benefit-kicker">Estimulación Cognitiva</span>
            <h3 class="wide-card-title">Olfato libre y reducción real de estrés</h3>
            <p class="wide-card-text">
              El olfato es la ventana principal a través de la cual los perros procesan el mundo. En Happy Paws no hacemos caminatas apresuradas con tirones constantes. Permitimos pausas de olfato guiadas que estimulan su cerebro, reducen los niveles de cortisol y disminuyen la ansiedad acumulada en casa.
            </p>
            <div class="benefit-tags">
              <span class="b-tag">Pausas a su ritmo</span>
              <span class="b-tag">Baja niveles de ansiedad</span>
              <span class="b-tag">Cero tirones de correa</span>
            </div>
          </div>
        </article>

        <!-- Bloque Amplio 2: Ejercicio y Salud Física -->
        <article class="wide-benefit-card wide-card-reverse">
          <div class="wide-card-media">
            <img
              src="/images/group-walk.jpg"
              alt="Perros sociables caminando coordinadamente en pasto sin tirones"
              loading="lazy"
            />
          </div>
          <div class="wide-card-content">
            <span class="benefit-kicker">Salud Física y Socialización</span>
            <h3 class="wide-card-title">Actividad adaptada a su energía y edad</h3>
            <p class="wide-card-text">
              Ejercicio moderado en los senderos arbolados de Foresta que cuida sus articulaciones y fortalece su sistema cardiovascular. Si tu perro es sociable, convive en manadas pequeñas de máximo 3 a 4 perros con temperamentos compatibles; si es tímido o senior, disfruta de una caminata individual 100% a su ritmo.
            </p>
            <div class="benefit-tags">
              <span class="b-tag">Cuidado de almohadillas</span>
              <span class="b-tag">Paseo individual o grupal reducido</span>
              <span class="b-tag">Socialización armónica</span>
            </div>
          </div>
        </article>
      </div>

      <!-- Strip de 3 Pilares Adicionales de Bienestar (Estilo Petme vp-trust-strip) -->
      <div class="benefits-strip-grid">
        <div class="strip-card">
          <div class="strip-icon-box">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path>
              <polyline points="9 22 9 12 15 12 15 22"></polyline>
            </svg>
          </div>
          <h4>Descanso profundo en el hogar</h4>
          <p>
            Un perro con sus necesidades de ejercicio y olfato satisfechas llega a casa a descansar. Menos ladridos por aburrimiento, menos hiperactividad y mayor concentración para ti mientras trabajas.
          </p>
        </div>

        <div class="strip-card">
          <div class="strip-icon-box">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
            </svg>
          </div>
          <h4>Manejo respetuoso y seguro</h4>
          <p>
            Solo usamos correas seguras y arnés ergonómico provisto por su familia. Monitoreamos constantemente el lenguaje corporal de tu perro para prevenir tensiones innecesarias con otros perros.
          </p>
        </div>

        <div class="strip-card">
          <div class="strip-icon-box">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <circle cx="12" cy="12" r="10"></circle>
              <polyline points="12 6 12 12 16 14"></polyline>
            </svg>
          </div>
          <h4>Rutina consistente y predecible</h4>
          <p>
            Puntualidad en puerta acordada. Tu perro cumple su rutina diaria sin importar lo ocupado que esté tu día de trabajo o tus compromisos familiares en Foresta.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- ================= 3. CÓMO FUNCIONA HAPPY PAWS (Estilo Petme hiw-steps) ================= -->
  <section class="section-wrapper section-alt hiw-clean-section" id="como-funciona">
    <div class="container">
      <div class="section-header">
        <span class="badge badge-orange">Proceso Sencillo</span>
        <h2>Cómo funciona Happy Paws en Foresta Dream Lagoons</h2>
        <p>
          Tres pasos claros y sin complicaciones para comenzar a pasear a tu perro con total confianza.
        </p>
      </div>

      <div class="hiw-steps-row">
        <!-- Paso 1 -->
        <div class="hiw-step-col">
          <div class="hiw-step-num-wrap">
            <span class="hiw-step-num">1</span>
          </div>
          <div class="hiw-step-content">
            <h3 class="hiw-step-heading">Escríbenos por WhatsApp</h3>
            <p class="hiw-step-text">
              Nos cuentas sobre tu perro: nombre, edad, nivel de energía, necesidades específicas y los horarios en que requieres el paseo dentro de Foresta.
            </p>
          </div>
        </div>

        <!-- Paso 2 -->
        <div class="hiw-step-col">
          <div class="hiw-step-num-wrap">
            <span class="hiw-step-num">2</span>
          </div>
          <div class="hiw-step-content">
            <h3 class="hiw-step-heading">Charla de conocimiento</h3>
            <p class="hiw-step-text">
              Acudimos a tu domicilio en Foresta para conocer a tu mascota en un entorno de confianza, revisar su arnés y acordar la modalidad ideal (individual o grupal).
            </p>
          </div>
        </div>

        <!-- Paso 3 -->
        <div class="hiw-step-col">
          <div class="hiw-step-num-wrap">
            <span class="hiw-step-num">3</span>
          </div>
          <div class="hiw-step-content">
            <h3 class="hiw-step-heading">Paseo seguro y reporte directo</h3>
            <p class="hiw-step-text">
              Recogida puntual en puerta, caminata atenta por áreas verdes y entrega con reporte en tu teléfono con duración, hidratación y foto del recorrido.
            </p>
          </div>
        </div>
      </div>

      <div class="hiw-cta-center">
        <WhatsAppButton
          context="process"
          text="Iniciar proceso por WhatsApp"
          variant="whatsapp"
          size="lg"
          id="how-it-works-cta"
        />
      </div>
    </div>
  </section>

  <!-- ================= 4. REPORTE POST-PASEO (Mockup limpio) ================= -->
  <PostWalkReport />

  <!-- ================= 5. PREGUNTAS FRECUENTES ================= -->
  <section class="section-wrapper section-surface faq-clean-section" id="faq">
    <div class="container">
      <div class="section-header">
        <span class="badge badge-orange">Preguntas Frecuentes</span>
        <h2>Dudas comunes de los residentes de Foresta</h2>
        <p>
          Respuestas transparentes sobre dinámica, tiempos, seguridad y reservas en Happy Paws.
        </p>
      </div>

      <FAQAccordion />

      <div class="faq-footer-helper">
        <p>¿Tienes otra pregunta sobre tu perro o tus horarios?</p>
        <WhatsAppButton
          context="faq"
          text="Pregúntanos por WhatsApp"
          variant="outline"
          size="md"
        />
      </div>
    </div>
  </section>

  <!-- ================= 6. CTA FINAL DESTACADO (Estilo Petme fcta-card) ================= -->
  <section class="section-wrapper final-cta-clean-section" id="contacto">
    <div class="container">
      <div class="fcta-banner">
        <div class="fcta-content-side">
          <span class="badge badge-orange">Atención Inmediata</span>
          <h2 class="fcta-title">
            Dale a tu perro su momento favorito del día en Foresta
          </h2>
          <p class="fcta-description">
            Sin registros complejos ni intermediarios. Conversa directamente por WhatsApp con quien cuidará a tu mascota y coordinemos su primera salida.
          </p>
          <div class="fcta-actions">
            <WhatsAppButton
              context="main"
              text="Quiero conocer el servicio"
              variant="primary"
              size="lg"
              id="final-section-cta"
            />
          </div>
          <span class="fcta-note">
            Servicio exclusivo para la comunidad de Foresta Dream Lagoons.
          </span>
        </div>

        <div class="fcta-image-side">
          <img
            src="/images/care-checkin.jpg"
            alt="Paseador de Happy Paws atendiendo a un perro con cariño antes de salir"
            loading="lazy"
          />
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* ================= HERO CLEAN ================= */
  .hero-clean {
    padding-top: var(--space-12);
    padding-bottom: var(--space-16);
    background: linear-gradient(180deg, #FAF7F2 0%, #FFF9F4 100%);
  }

  .hero-clean-container {
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    gap: var(--space-12);
    align-items: center;
  }

  .hero-clean-content {
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
  }

  .location-chip {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    background-color: var(--color-primary-light);
    border: 1px solid var(--color-primary-border);
    color: var(--color-primary);
    padding: 6px 14px;
    border-radius: var(--radius-full);
    font-size: 0.825rem;
    font-weight: 700;
    letter-spacing: 0.02em;
    width: fit-content;
  }

  .chip-pin {
    color: var(--color-primary);
  }

  .hero-clean-title {
    font-size: clamp(2.3rem, 4.2vw, 3.5rem);
    line-height: 1.15;
    color: var(--color-text-title);
    letter-spacing: -0.03em;
  }

  .text-highlight {
    color: var(--color-primary);
  }

  .hero-clean-subtitle {
    font-size: clamp(1.1rem, 1.8vw, 1.25rem);
    line-height: 1.6;
    color: var(--color-text-muted);
    max-width: 580px;
  }

  .hero-clean-ctas {
    display: flex;
    gap: var(--space-4);
    align-items: center;
    flex-wrap: wrap;
    margin-top: var(--space-2);
  }

  .hero-clean-trust {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    padding-top: var(--space-4);
    border-top: 1px solid var(--color-border);
    margin-top: var(--space-2);
  }

  .trust-point {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    font-size: 0.925rem;
    font-weight: 600;
    color: var(--color-text);
  }

  .check-bullet {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background-color: var(--color-primary);
  }

  .hero-clean-media {
    position: relative;
  }

  .hero-frame {
    position: relative;
    border-radius: var(--radius-xl);
    overflow: hidden;
    box-shadow: var(--shadow-xl);
    border: 4px solid #FFFFFF;
    background: #FFFFFF;
  }

  .hero-clean-img {
    width: 100%;
    height: 480px;
    object-fit: cover;
    display: block;
    border-radius: calc(var(--radius-xl) - 4px);
  }

  .hero-clean-badge {
    position: absolute;
    bottom: 20px;
    left: 20px;
    right: 20px;
    background: rgba(255, 255, 255, 0.95);
    backdrop-filter: blur(10px);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: 12px 18px;
    display: flex;
    flex-direction: column;
    box-shadow: var(--shadow-lg);
  }

  .badge-tag {
    font-size: 0.725rem;
    font-weight: 700;
    text-transform: uppercase;
    color: var(--color-primary);
    letter-spacing: 0.05em;
  }

  .badge-title {
    font-size: 0.95rem;
    font-weight: 700;
    color: var(--color-text-title);
  }

  /* ================= BENEFICIOS AMPLIOS (Estilo Petme) ================= */
  .benefits-expanded-section {
    background-color: var(--color-surface);
  }

  .benefits-wide-grid {
    display: flex;
    flex-direction: column;
    gap: var(--space-12);
    margin-bottom: var(--space-16);
  }

  .wide-benefit-card {
    display: grid;
    grid-template-columns: 1fr 1fr;
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xl);
    overflow: hidden;
    box-shadow: var(--shadow-sm);
    transition: transform var(--transition-normal), box-shadow var(--transition-normal);
  }

  .wide-benefit-card:hover {
    transform: translateY(-3px);
    box-shadow: var(--shadow-lg);
  }

  .wide-card-reverse .wide-card-media {
    order: 2;
  }

  .wide-card-reverse .wide-card-content {
    order: 1;
  }

  .wide-card-media {
    height: 380px;
    overflow: hidden;
  }

  .wide-card-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--transition-smooth);
  }

  .wide-benefit-card:hover .wide-card-media img {
    transform: scale(1.03);
  }

  .wide-card-content {
    padding: var(--space-10);
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: var(--space-4);
  }

  .benefit-kicker {
    font-size: 0.775rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-primary);
  }

  .wide-card-title {
    font-size: clamp(1.4rem, 2.2vw, 1.85rem);
    color: var(--color-text-title);
    line-height: 1.25;
  }

  .wide-card-text {
    font-size: 1rem;
    line-height: 1.65;
    color: var(--color-text-muted);
  }

  .benefit-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: var(--space-2);
  }

  .b-tag {
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    padding: 5px 12px;
    border-radius: var(--radius-full);
    font-size: 0.825rem;
    font-weight: 600;
    color: var(--color-text);
  }

  /* Strip de 3 Cards */
  .benefits-strip-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-6);
  }

  .strip-card {
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xl);
    padding: var(--space-8);
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .strip-icon-box {
    width: 48px;
    height: 48px;
    border-radius: var(--radius-lg);
    background-color: var(--color-primary-light);
    color: var(--color-primary);
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: var(--space-2);
  }

  .strip-card h4 {
    font-size: 1.15rem;
    color: var(--color-text-title);
  }

  .strip-card p {
    font-size: 0.925rem;
    line-height: 1.6;
    color: var(--color-text-muted);
  }

  /* ================= CÓMO FUNCIONA (Estilo Petme) ================= */
  .hiw-clean-section {
    background-color: #FAF7F2;
  }

  .hiw-steps-row {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-8);
    margin-top: var(--space-8);
  }

  .hiw-step-col {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xl);
    padding: var(--space-8);
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    box-shadow: var(--shadow-sm);
  }

  .hiw-step-num-wrap {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background-color: var(--color-primary-light);
    color: var(--color-primary);
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 800;
    font-size: 1.25rem;
  }

  .hiw-step-heading {
    font-size: 1.25rem;
    color: var(--color-text-title);
    margin-bottom: var(--space-2);
  }

  .hiw-step-text {
    font-size: 0.95rem;
    line-height: 1.6;
    color: var(--color-text-muted);
  }

  .hiw-cta-center {
    display: flex;
    justify-content: center;
    margin-top: var(--space-12);
  }

  /* ================= FAQ FOOTER HELPER ================= */
  .faq-clean-section {
    background-color: #FFFFFF;
  }

  .faq-footer-helper {
    margin-top: var(--space-8);
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-3);
  }

  .faq-footer-helper p {
    font-size: 1rem;
    color: var(--color-text);
  }

  /* ================= FINAL CTA CLEAN (Estilo Petme) ================= */
  .final-cta-clean-section {
    padding-bottom: var(--space-20);
  }

  .fcta-banner {
    display: grid;
    grid-template-columns: 1.2fr 0.8fr;
    background: linear-gradient(135deg, #FFF6EE 0%, #FFEADA 100%);
    border: 2px solid var(--color-primary-border);
    border-radius: var(--radius-xl);
    overflow: hidden;
    box-shadow: var(--shadow-lg);
  }

  .fcta-content-side {
    padding: var(--space-12);
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: flex-start;
    gap: var(--space-4);
  }

  .fcta-title {
    font-size: clamp(1.8rem, 3vw, 2.5rem);
    color: var(--color-text-title);
    line-height: 1.2;
  }

  .fcta-description {
    font-size: 1.1rem;
    line-height: 1.6;
    color: var(--color-text);
    max-width: 540px;
  }

  .fcta-actions {
    margin-top: var(--space-2);
  }

  .fcta-note {
    font-size: 0.825rem;
    color: var(--color-text-subtle);
  }

  .fcta-image-side {
    height: 100%;
    min-height: 320px;
  }

  .fcta-image-side img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* ================= RESPONSIVE ================= */
  @media (max-width: 992px) {
    .hero-clean-container {
      grid-template-columns: 1fr;
    }
    .hero-clean-img {
      height: 360px;
    }
    .wide-benefit-card {
      grid-template-columns: 1fr;
    }
    .wide-card-reverse .wide-card-media {
      order: 1;
    }
    .wide-card-reverse .wide-card-content {
      order: 2;
    }
    .wide-card-media {
      height: 280px;
    }
    .benefits-strip-grid {
      grid-template-columns: 1fr;
    }
    .hiw-steps-row {
      grid-template-columns: 1fr;
    }
    .fcta-banner {
