---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroOmniBar from '../components/HeroOmniBar.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';
import FAQAccordion from '../components/FAQAccordion.astro';
import FaqSchema from '../components/FaqSchema.astro';
import PostWalkReport from '../components/PostWalkReport.astro';
// astro:assets optimiza en build: genera WebP/AVIF, declara width/height (con
// lo que el navegador reserva el espacio y desaparece el CLS) y produce srcset.
// Las fotos de public/ se servían tal cual: 736 KB de JPEG sin dimensiones.
import { Image } from 'astro:assets';
import heroWalk from '../assets/hero-walk.jpg';
import individualWalk from '../assets/individual-walk.jpg';
import groupWalk from '../assets/group-walk.jpg';
import careCheckin from '../assets/care-checkin.jpg';

const pageTitle = "Happy Paws Metepec | Paseos de Perros en Foresta Dream Lagoons";
const pageDesc = "Paseos de perros exclusivos en Foresta Dream Lagoons, Metepec. Atención personalizada 1 a 1, exploración a su ritmo y reporte con fotos en tu WhatsApp.";
---

<BaseLayout title={pageTitle} description={pageDesc} currentPath="/">
  <!-- ================= 1. FULL-SCREEN HERO (Estilo Petme con Omni-bar al centro) ================= -->
  <section class="hero-fullscreen" id="inicio">
    <div class="hero-bg-container" aria-hidden="true">
      <!-- Vídeo del hero: la imagen queda como respaldo si el mp4 no carga
           o si el usuario tiene el ahorro de datos activo.

           Dos variantes VP9 + un MP4 de respaldo:
           - `media="(max-width: 767px)"` en cada <source>: el navegador
             descarga SOLO la que corresponde al ancho actual. Móvil recibe
             480p (854x480, 3.6 MB) y escritorio 540p (960x540, 3.7 MB).
             Antes todo el mundo bajaba el mismo archivo.
           - VP9 en vez de H.264 para el mismo peso: medido con VMAF contra
             la fuente original 1080p, el VP9 480p saca 87.6 y el H.264 480p
             solo 77.2. La diferencia es real y se nota.
           - El MP4 queda al final como último recurso para navegadores sin
             VP9 (Safari/iOS antiguos), que ignoran los WebM y caen a él.
           - `playsinline` es obligatorio en iOS: sin él el vídeo se abre a
             pantalla completa y el usuario sale del sitio en el primer toque.
           - `disablepictureinpicture` quita el botón de PiP en Chrome. -->
      <video
        class="hero-bg-video"
        autoplay
        muted
        loop
        playsinline
        disablepictureinpicture
        preload="metadata"
        poster="/images/hero-poster.jpg"
      >
        <source
          src="/images/hero-walk-mobile.webm"
          type="video/webm"
          media="(max-width: 767px)"
        />
        <source src="/images/hero-walk.webm" type="video/webm" />
        <source src="/images/hero-walk.mp4" type="video/mp4" />
      </video>
      <Image
        src={heroWalk}
        alt=""
        class="hero-bg-image"
        loading="eager"
        fetchpriority="high"
        widths={[640, 768, 1024, 1200]}
        sizes="100vw"
      />
      <div class="hero-bg-overlay"></div>
    </div>

    <div class="container hero-fullscreen-content">
      <div class="hero-center-box">
        <div class="location-badge-hero">
          <svg class="pin-icon" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
            <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
            <circle cx="12" cy="10" r="3"></circle>
          </svg>
          <span>Exclusivo en Foresta Dream Lagoons</span>
        </div>

        <h1 class="hero-headline">
          El paseo que tu perro merece.
        </h1>

        <p class="hero-microcopy">
          Atención personalizada, exploración a su ritmo y reporte directo en tu teléfono en cada salida.
        </p>

        <!-- CTA tenue dividido en 3 (servicio / fecha / mascotas) con popovers -->
        <div class="hero-bar-container">
          <HeroOmniBar />
        </div>

        <!-- Micro-puntos de confianza al centro -->
        <div class="hero-trust-row">
          <span>Rutas seguras dentro de Foresta</span>
          <span class="trust-dot">·</span>
          <span>Individual o máx. 3-4 perros</span>
          <span class="trust-dot">·</span>
          <span>Reporte y foto tras cada salida</span>
        </div>
      </div>
    </div>
  </section>

  <!-- ================= 2. BENEFICIOS PARA LA MASCOTA (DISEÑO MÁS AMPLIO - Estilo Petme) ================= -->
  <section class="section-wrapper section-surface benefits-expanded-section" id="beneficios">
    <div class="container">
      <div class="section-header">
        <span class="badge badge-orange">Bienestar para tu Mascota</span>
        <h2>¿Por qué un paseo dedicado mejora la salud física y mental de tu perro?</h2>
        <p>
          Caminar a su ritmo por las áreas verdes de Foresta reduce el estrés y la ansiedad gracias a pausas de olfato guiadas. El ejercicio moderado cuida sus articulaciones, previene conductas destructivas y le devuelve su calma natural al llegar a casa.
        </p>
      </div>

      <!-- Tarjetas Amplias Editoriales de Beneficios -->
      <div class="benefits-wide-grid">
        <!-- Bloque Amplio 1: Estimulación Olfativa -->
        <article class="wide-benefit-card">
          <div class="wide-card-media">
            <Image
              src={individualWalk}
              alt="Perro explorando y oliendo con calma en un paseo individual atento"
              class="benefit-img-individual"
              loading="lazy"
              widths={[400, 600, 768, 1024, 1200]}
              sizes="(max-width: 640px) calc(100vw - 32px), (max-width: 992px) calc(100vw - 48px), 560px"
            />
          </div>
          <div class="wide-card-content">
            <h3 class="wide-card-title">Olfato libre y reducción real de estrés</h3>
            <p class="wide-card-text">
              El olfato es la ventana principal a través de la cual los perros procesan el mundo. En Happy Paws no hacemos caminatas apresuradas con tirones constantes. Permitimos pausas de olfato guiadas que estimulan su cerebro, reducen los niveles de cortisol y disminuyen la ansiedad acumulada en casa.
            </p>
            <div class="benefit-tags">
              <span class="b-tag">
                <svg class="b-tag-icon" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
                Pausas a su ritmo
              </span>
              <span class="b-tag">
                <svg class="b-tag-icon" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
                Baja niveles de ansiedad
              </span>
              <span class="b-tag">
                <svg class="b-tag-icon" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
                Cero tirones de correa
              </span>
            </div>
          </div>
        </article>

        <!-- Bloque Amplio 2: Ejercicio y Salud Física -->
        <article class="wide-benefit-card wide-card-reverse">
          <div class="wide-card-media">
            <Image
              src={groupWalk}
              alt="Perros sociables caminando coordinadamente en pasto sin tirones"
              class="benefit-img-group"
              loading="lazy"
              widths={[400, 600, 768, 1024, 1200]}
              sizes="(max-width: 640px) calc(100vw - 32px), (max-width: 992px) calc(100vw - 48px), 560px"
            />
          </div>
          <div class="wide-card-content">
            <h3 class="wide-card-title">Actividad adaptada a su energía y edad</h3>
            <p class="wide-card-text">
              Ejercicio moderado en los senderos arbolados de Foresta que cuida sus articulaciones y fortalece su sistema cardiovascular. Si tu perro es sociable, convive en manadas pequeñas de máximo 3 a 4 perros con temperamentos compatibles; si es tímido o senior, disfruta de una caminata individual 100% a su ritmo.
            </p>
            <div class="benefit-tags">
              <span class="b-tag">
                <svg class="b-tag-icon" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
                Cuidado de almohadillas
              </span>
              <span class="b-tag">
                <svg class="b-tag-icon" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
                Paseo individual o grupal reducido
              </span>
              <span class="b-tag">
                <svg class="b-tag-icon" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
                Socialización armónica
              </span>
            </div>
          </div>
        </article>
      </div>

      <!-- Strip de 3 Pilares Adicionales de Bienestar con Cabecera Integrada -->
      <div class="benefits-strip-grid">
        <div class="strip-card">
          <div class="strip-card-header">
            <div class="strip-card-icon" aria-hidden="true">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
                <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path>
                <polyline points="9 22 9 12 15 12 15 22"></polyline>
              </svg>
            </div>
            <h4>Descanso profundo en el hogar</h4>
          </div>
          <p>
            Un perro con sus necesidades de ejercicio y olfato satisfechas llega a casa a descansar. Menos ladridos por aburrimiento, menos hiperactividad y mayor concentración para ti mientras trabajas.
          </p>
          <div class="strip-card-footer">
            <span class="strip-card-highlight">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
              Ambiente sereno para home-office
            </span>
          </div>
        </div>

        <div class="strip-card">
          <div class="strip-card-header">
            <div class="strip-card-icon" aria-hidden="true">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
                <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
              </svg>
            </div>
            <h4>Manejo respetuoso y seguro</h4>
          </div>
          <p>
            Solo usamos correas seguras y arnés ergonómico provisto por su familia. Monitoreamos constantemente el lenguaje corporal de tu perro para prevenir tensiones innecesarias con otros perros.
          </p>
          <div class="strip-card-footer">
            <span class="strip-card-highlight">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
              Cero métodos de aversión o castigo
            </span>
          </div>
        </div>

        <div class="strip-card">
          <div class="strip-card-header">
            <div class="strip-card-icon" aria-hidden="true">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
                <circle cx="12" cy="12" r="10"></circle>
                <polyline points="12 6 12 12 16 14"></polyline>
              </svg>
            </div>
            <h4>Rutina consistente y predecible</h4>
          </div>
          <p>
            Puntualidad en puerta acordada. Tu perro cumple su rutina diaria sin importar lo ocupado que esté tu día de trabajo o tus compromisos familiares en Foresta.
          </p>
          <div class="strip-card-footer">
            <span class="strip-card-highlight">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
              Horarios estables lunes a sábado
            </span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ================= 3. CÓMO FUNCIONA HAPPY PAWS (Estilo Petme hiw-steps) ================= -->
  <section class="section-wrapper section-alt hiw-clean-section" id="como-funciona">
    <div class="container">
      <div class="section-header">
        <span class="badge badge-orange">Proceso Sencillo</span>
        <h2>¿Cómo funciona el servicio de paseos de Happy Paws?</h2>
        <p>
          Iniciamos con una consulta directa por WhatsApp y agendamos una charla de conocimiento en tu puerta para evaluar el temperamento de tu perro. Tras acordar horarios, realizamos caminatas seguras dentro de Foresta Dream Lagoons con reporte fotográfico al finalizar.
        </p>
      </div>

      <div class="hiw-steps-row">
        <!-- Paso 1 -->
        <div class="hiw-step-col">
          <div class="hiw-step-header">
            <div class="hiw-step-num-wrap">
              <span class="hiw-step-num">1</span>
            </div>
            <span class="hiw-step-tag">2 min</span>
          </div>
          <div class="hiw-step-content">
            <h3 class="hiw-step-heading">Elige y consulta</h3>
            <p class="hiw-step-text">
              Selecciona tu modalidad, fecha tentativa y número de mascotas en la barra superior o escríbenos directamente por WhatsApp.
            </p>
          </div>
          <div class="hiw-step-footer">
            <span class="hiw-step-highlight">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
              Atención directa por WhatsApp
            </span>
          </div>
        </div>

        <!-- Paso 2 -->
        <div class="hiw-step-col">
          <div class="hiw-step-header">
            <div class="hiw-step-num-wrap">
              <span class="hiw-step-num">2</span>
            </div>
            <span class="hiw-step-tag">En tu puerta</span>
          </div>
          <div class="hiw-step-content">
            <h3 class="hiw-step-heading">Charla de conocimiento</h3>
            <p class="hiw-step-text">
              Acudimos a tu domicilio en Foresta para conocer a tu mascota en un entorno de confianza, revisar su arnés y acordar la ruta ideal.
            </p>
          </div>
          <div class="hiw-step-footer">
            <span class="hiw-step-highlight">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
              Revisión de arnés y temperamento
            </span>
          </div>
        </div>

        <!-- Paso 3 -->
        <div class="hiw-step-col">
          <div class="hiw-step-header">
            <div class="hiw-step-num-wrap">
              <span class="hiw-step-num">3</span>
            </div>
            <span class="hiw-step-tag">Vía WhatsApp</span>
          </div>
          <div class="hiw-step-content">
            <h3 class="hiw-step-heading">Paseo seguro y reporte</h3>
            <p class="hiw-step-text">
              Recogida puntual en puerta, caminata atenta por áreas verdes y entrega con reporte en tu teléfono con duración, hidratación y foto.
            </p>
          </div>
          <div class="hiw-step-footer">
            <span class="hiw-step-highlight">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/></svg>
              Reporte con foto al finalizar
            </span>
          </div>
        </div>
      </div>

      <div class="hiw-cta-center">
        <WhatsAppButton
          context="process"
          text="Iniciar proceso por WhatsApp"
          variant="whatsapp"
          size="lg"
          id="how-it-works-cta"
        />
      </div>
    </div>
  </section>

  <!-- ================= 4. REPORTE POST-PASEO (Mockup limpio) ================= -->
  <PostWalkReport />

  <!-- ================= 5. PREGUNTAS FRECUENTES ================= -->
  <section class="section-wrapper section-surface faq-clean-section" id="faq">
    <div class="container">
      <div class="section-header">
        <span class="badge badge-orange">Preguntas Frecuentes</span>
        <h2>¿Dónde opera Happy Paws y qué debes saber del servicio?</h2>
        <p>
          Operamos de manera exclusiva dentro de Foresta Dream Lagoons en Metepec. Aquí resolvemos las dudas más frecuentes sobre horarios, seguridad y bienestar para tu perro.
        </p>
      </div>

      <FAQAccordion />
      <FaqSchema />

      <div class="faq-footer-helper">
        <p>¿Tienes otra pregunta sobre tu perro o tus horarios?</p>
        <WhatsAppButton
          context="faq"
          text="Pregúntanos por WhatsApp"
          variant="outline"
          size="md"
        />
      </div>
    </div>
  </section>

  <!-- ================= 6. CTA FINAL DESTACADO (Estilo Petme fcta-card) ================= -->
  <section class="section-wrapper final-cta-clean-section" id="contacto">
    <div class="container">
      <div class="fcta-banner">
        <div class="fcta-content-side">
          <span class="badge badge-orange">Atención Inmediata</span>
          <h2 class="fcta-title">
            Dale a tu perro su momento favorito del día en Foresta
          </h2>
          <p class="fcta-description">
            Sin registros complejos ni intermediarios. Conversa directamente por WhatsApp con quien cuidará a tu mascota y coordinemos su primera salida.
          </p>
          <div class="fcta-actions">
            <WhatsAppButton
              context="main"
              text="Quiero conocer el servicio"
              variant="primary"
              size="lg"
              id="final-section-cta"
            />
          </div>
          <span class="fcta-note">
            Servicio exclusivo para la comunidad de Foresta Dream Lagoons.
          </span>
        </div>

        <div class="fcta-image-side">
          <Image
            src={careCheckin}
            alt="Paseador de Happy Paws atendiendo a un perro con cariño antes de salir"
            loading="lazy"
            widths={[400, 600, 768, 1024, 1200]}
            sizes="(max-width: 640px) calc(100vw - 32px), (max-width: 992px) calc(100vw - 48px), 480px"
          />
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* ================= FULL-SCREEN HERO (Estilo Petme) ================= */
  .hero-fullscreen {
    position: relative;
    /* dvh en lugar de vh: en móvil la barra del navegador aparece y desaparece,
       y con 100vh el hero "respira" y desplaza el omnibar justo cuando el
       usuario va a tocarlo. dvh sigue a la barra. */
    min-height: calc(100dvh - var(--header-height));
    display: flex;
    align-items: center;
    justify-content: center;
    padding: var(--space-16) 0 var(--space-20) 0;
    /* overflow: hidden removed — .hero-bg-container already clips the scaled image.
       Keeping this visible allows omnibar popovers to overflow the section bounds. */
  }

  .hero-bg-container {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 1;
    overflow: hidden;
  }

  /* El vídeo cubre el hero igual que la foto. Se apila encima: mientras no
     reproduce se ve la imagen de debajo, así el fallback es automático.

     Rendimiento en móvil (el punto que más lag provocaba):
     - `transform: translateZ(0)` crea una capa de composición propia, así el
       reescalado de 720p -> pantalla lo hace la GPU y no la CPU. Sin esto el
       navegador redecodifica/reescala el vídeo en cada scroll en móviles de
       gama baja.
     - `will-change: transform` le dice al compositor que prepare esa capa
       antes del primer frame en vez de hacerlo en caliente.
     - `contain: layout paint` aísla el contenedor: el vídeo no puede forzar
       repintados fuera de su propia caja cuando el resto de la página hace
       scroll.
     - `object-position` igual al de la foto para que el encuadre no "salte"
       cuando el vídeo aparece encima de la imagen. */
  .hero-bg-video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 35%;
    z-index: 2;
    transform: translateZ(0);
    will-change: transform;
    backface-visibility: hidden;
  }

  .hero-bg-image {
    /* <Image> emite width/height nativos; sin anularlos la foto aparecería
       con su relación de aspecto original en lugar de cubrir el hero. */
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 35%;
    z-index: 1;
  }

  /* Con el ahorro de datos o si el mp4 falla, el vídeo se queda en el
     póster: se quita de encima para que no tape la imagen. */
  @media (prefers-reduced-data: reduce) {
    .hero-bg-video {
      display: none;
    }
  }

  /* Igual para quien pidió menos movimiento: un bucle continuo a pantalla
     completa es justo lo que quieren evitar. Se oculta el <video> y queda
     visible la imagen de debajo, que es un frame de la misma escena. */
  @media (prefers-reduced-motion: reduce) {
    .hero-bg-video {
      display: none;
    }
  }

  .hero-bg-overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    /* Debe ir por encima del vídeo (z-index 2) o el degradado no se aplica
       y el texto pierde contraste sobre la imagen en movimiento. */
    z-index: 3;
    background: linear-gradient(
      180deg,
      rgba(20, 18, 16, 0.48) 0%,
      rgba(20, 18, 16, 0.68) 50%,
      rgba(20, 18, 16, 0.85) 100%
    );
  }

  .hero-fullscreen-content {
    position: relative;
    z-index: 10;
    width: 100%;
  }

  .hero-center-box {
    max-width: 860px;
    margin: 0 auto;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-5);
  }

  .location-badge-hero {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    background: rgba(255, 255, 255, 0.16);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    border: 1px solid rgba(255, 255, 255, 0.35);
    color: #FFFFFF;
    padding: 6px 16px;
    border-radius: var(--radius-full);
    font-size: 0.825rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .pin-icon {
    color: #FF8A4C;
  }

