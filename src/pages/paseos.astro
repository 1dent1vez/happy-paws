---
import BaseLayout from '../layouts/BaseLayout.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';
import FAQAccordion from '../components/FAQAccordion.astro';
import FaqSchema from '../components/FaqSchema.astro';
import { Image } from 'astro:assets';
import careCheckin from '../assets/care-checkin.jpg';
import individualWalk from '../assets/walk-individual.jpg';
import groupWalk from '../assets/walk-terriers.jpg';
import restMoment from '../assets/walk-rest.jpg';

const pageTitle = "Paseo individual y grupal en Foresta | Happy Paws Metepec";
const pageDesc = "Paseos individuales y en grupos reducidos en Foresta Dream Lagoons, Metepec. Rutas seguras, estimulación olfativa y reporte detallado con fotos en WhatsApp.";
---

<BaseLayout title={pageTitle} description={pageDesc} currentPath="/paseos/">
  <!-- ================= 1. HERO PASEOS ================= -->
  <section class="page-hero" data-page-hero>
    <div class="container page-hero-container">
      <div class="page-hero-text">
        <h1 class="page-hero-title">
          Paseos a<br />su ritmo.<br />
          <span class="text-highlight">en Foresta Dream Lagoons.</span>
        </h1>
        <p class="lead">
          Conoce las opciones para su paseo dentro de Foresta: atención individual o compañía en un grupo pequeño. Te ayudamos a elegir y te contamos cómo le fue al regresar.
        </p>

        <div class="page-hero-ctas">
          <WhatsAppButton
            context="paseosPage"
            text="Consultar disponibilidad en Foresta"
            variant="primary"
            size="lg"
            id="paseos-hero-cta"
          />
          <a href="#comparativa" class="btn btn-secondary btn-lg">
            Ver modalidades
          </a>
        </div>
      </div>

      <div class="page-hero-media">
        <Image
          src={careCheckin}
          alt="Perro acompañado antes de salir a pasear"
          class="page-hero-img"
          loading="eager"
          widths={[400, 600, 768, 1024, 1200]}
          sizes="(max-width: 699px) 90vw, 50vw"
        />
        <p class="hero-photo-note">De 45 a 60 minutos.<br />Dentro de Foresta.</p>
      </div>
    </div>
  </section>

  <!-- ================= 2. MODALIDADES EN DETALLE ================= -->
  <section class="section-wrapper section-surface" id="comparativa">
    <div class="container">
      <div class="section-header">
        <h2>¿Paseo individual o grupal para tu perro?</h2>
        <p>
          No necesitas decidir antes de escribirnos. Hablamos de su edad, energía y cómo se siente con otros perros para recomendarte una opción.
        </p>
      </div>

      <div class="modalities-grid">
        <!-- MODALIDAD INDIVIDUAL -->
        <article class="modality-detail-card" id="individual">
          <Image class="modality-photo" src={individualWalk} alt="Perro pequeño caminando con correa sobre el césped" loading="lazy" widths={[400,700,1000]} sizes="(max-width: 699px) 100vw, 45vw" />
          <div class="modality-header">
            <h3 class="modality-title">Individual: toda la atención para él</h3>
            <p class="modality-subtitle">Atención dedicada, ritmo sereno y exploración a su medida.</p>
          </div>

          <div class="modality-body">
            <p class="modality-intro">
              Pensado para perros que disfrutan caminar a su propio compás, aquellos que se sobreestimulan fácilmente con otros canes o perritos en etapas especiales de vida.
            </p>

            <details class="modality-points">
              <summary>¿Cómo funciona y qué incluye?</summary>
              <ul class="points-list">
                <li class="point-item">
                  <span class="point-icon" aria-hidden="true">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
                  </span>
                  <div class="point-content">
                    <strong>Atención exclusiva:</strong> El paseador está exclusivamente pendiente de las señales corporales y bienestar de tu perro.
                  </div>
                </li>
                <li class="point-item">
                  <span class="point-icon" aria-hidden="true">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
                  </span>
                  <div class="point-content">
                    <strong>Ritmo personalizado:</strong> Si necesita parar a olfatear 5 minutos un mismo punto o caminar despacio por su edad, respetamos sus tiempos.
                  </div>
                </li>
                <li class="point-item">
                  <span class="point-icon" aria-hidden="true">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
                  </span>
                  <div class="point-content">
                    <strong>Ruta tranquila en Foresta:</strong> Recorremos senderos seguros y áreas verdes de baja congestión dentro del fraccionamiento.
                  </div>
                </li>
                <li class="point-item">
                  <span class="point-icon" aria-hidden="true">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
                  </span>
                  <div class="point-content">
                    <strong>Sin contacto forzado:</strong> Evitamos cruces incómodos con otros perros respetando su espacio.
                  </div>
                </li>
                <li class="point-item">
                  <span class="point-icon" aria-hidden="true">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
                  </span>
                  <div class="point-content">
                    <strong>Reporte y foto post-salida:</strong> Mensaje detallado al entregarlo en tu puerta.
                  </div>
                </li>
              </ul>
            </details>

            <div class="modality-profile">
              <div class="profile-header">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" class="profile-icon" aria-hidden="true">
                  <circle cx="12" cy="12" r="10"></circle>
                  <line x1="12" y1="16" x2="12" y2="12"></line>
                  <line x1="12" y1="8" x2="12.01" y2="8"></line>
                </svg>
                <span class="profile-label">¿Para quién es?</span>
              </div>
              <p>Perros tímidos, reactivos a la correa, adultos mayores (senior), cachorros en proceso de aprendizaje o familias que buscan atención exclusiva.</p>
            </div>

            <div class="modality-pricing-box">
              <div class="pricing-header">
                <span class="pricing-label">Tarifa y horarios</span>
                <span class="pricing-badge">Consulta por WhatsApp</span>
              </div>
              <p class="pricing-text">
                La tarifa depende de la modalidad y de cuántos paseos necesitas por semana. Te compartimos por WhatsApp las opciones por sesión o paquete mensual y sus horarios disponibles.
              </p>
              <WhatsAppButton
                context="individual"
                text="Consultar paseo individual"
                variant="whatsapp"
                size="md"
                className="w-full"
                id="cta-individual-detail"
              />
            </div>
          </div>
        </article>

        <!-- MODALIDAD GRUPAL -->
        <article class="modality-detail-card modality-detail-featured" id="grupal">
          <Image class="modality-photo" src={groupWalk} alt="Dos perros con correa compartiendo una caminata al atardecer" loading="lazy" widths={[400,700,1000]} sizes="(max-width: 699px) 100vw, 45vw" />
          <div class="modality-header">
            <h3 class="modality-title">Grupal: compañía en un grupo pequeño</h3>
            <p class="modality-subtitle">Caminatas acompañadas con perros compatibles.</p>
          </div>

          <div class="modality-body">
            <p class="modality-intro">
              Una salida dinámica y divertida para perros con ganas de convivir. Cuidamos rigurosamente que todos los integrantes del grupo se lleven bien y tengan energías afines.
            </p>

            <details class="modality-points">
              <summary>¿Cómo funciona y qué incluye?</summary>
              <ul class="points-list">
                <li class="point-item">
                  <span class="point-icon" aria-hidden="true">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
                  </span>
                  <div class="point-content">
                    <strong>Hasta 4 perros por paseador:</strong> Formamos grupos pequeños y observamos cómo se siente cada perro durante el recorrido.
                  </div>
                </li>
                <li class="point-item">
                  <span class="point-icon" aria-hidden="true">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
                  </span>
                  <div class="point-content">
                    <strong>Evaluación previa obligatoria:</strong> Nunca integramos a un perro nuevo sin antes haber evaluado su lenguaje corporal y compatibilidad con el grupo.
                  </div>
                </li>
                <li class="point-item">
                  <span class="point-icon" aria-hidden="true">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
                  </span>
                  <div class="point-content">
                    <strong>Correas desenredadas y manejo seguro:</strong> Caminata coordinada en paralelo evitando juegos bruscos con las correas puestas.
                  </div>
                </li>
                <li class="point-item">
                  <span class="point-icon" aria-hidden="true">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
                  </span>
                  <div class="point-content">
                    <strong>Pausas conjuntas de descanso:</strong> Momentos de sombra e hidratación fresca individual para cada perro.
                  </div>
                </li>
                <li class="point-item">
                  <span class="point-icon" aria-hidden="true">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
                  </span>
                  <div class="point-content">
                    <strong>Reporte de convivencia:</strong> Te informamos cómo interactuó con sus compañeros y su estado de ánimo.
                  </div>
                </li>
              </ul>
            </details>

            <div class="modality-profile">
              <div class="profile-header">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" class="profile-icon" aria-hidden="true">
                  <circle cx="12" cy="12" r="10"></circle>
                  <line x1="12" y1="16" x2="12" y2="12"></line>
                  <line x1="12" y1="8" x2="12.01" y2="8"></line>
                </svg>
                <span class="profile-label">¿Para quién es?</span>
              </div>
              <p>Perros sociables, activos, equilibrados y con gusto por convivir y pasear al lado de otros amigos caninos.</p>
            </div>

            <div class="modality-pricing-box">
              <div class="pricing-header">
                <span class="pricing-label">Tarifa y horarios</span>
                <span class="pricing-badge">Según compatibilidad</span>
              </div>
              <p class="pricing-text">
                Disponibilidad y cupos sujetos a compatibilidad de grupo en Foresta Dream Lagoons. Consúltanos por WhatsApp.
              </p>
              <WhatsAppButton
                context="group"
                text="Consultar paseo grupal"
                variant="primary"
                size="md"
                className="w-full"
                id="cta-group-detail"
              />
            </div>
          </div>
        </article>
      </div>
    </div>
  </section>

  <!-- ================= 3. EL PROTOCOLO PASO A PASO ================= -->
  <section class="section-wrapper" id="proceso">
    <div class="container">
      <div class="section-header">
        <h2>De tu puerta al paseo, y de vuelta contigo.</h2>
        <p>
          Acordamos los detalles contigo, revisamos su arnés antes de salir y caminamos dentro de Foresta. Al regresar, te enviamos su reporte por WhatsApp.
        </p>
      </div>

      <div class="timeline-container">
        <!-- Paso 1 -->
        <div class="timeline-item">
          <div class="timeline-dot">1</div>
          <div class="timeline-card">
            <div class="timeline-card-header">
              <span class="timeline-time-badge">Por WhatsApp</span>
            </div>
            <h3>Evaluación y Conocimiento del Perro</h3>
            <p>
              Al escribirnos por WhatsApp recopilamos datos clave: nombre, edad, nivel de actividad, comportamiento ante ruidos o personas extrañas y antecedentes de salud. Si es para grupal, programamos una breve sesión de observación previa en Foresta.
            </p>
          </div>
        </div>

        <!-- Paso 2 -->
        <div class="timeline-item">
          <div class="timeline-dot">2</div>
          <div class="timeline-card">
            <div class="timeline-card-header">
              <span class="timeline-time-badge">Puntual en puerta</span>
            </div>
            <h3>Llegada Puntual y Preparación</h3>
            <p>
              Te notificamos por WhatsApp al aproximarnos a tu domicilio. Saludamos con calma a tu perro, revisamos que su arnés o pechera esté debidamente ajustado y salimos sin acelerar su emoción.
            </p>
          </div>
        </div>

        <!-- Paso 3 -->
        <div class="timeline-item">
          <div class="timeline-dot">3</div>
          <div class="timeline-card">
            <div class="timeline-card-header">
              <span class="timeline-time-badge">45 a 60 min</span>
            </div>
            <h3>Caminata Activa, Olfato e Hidratación</h3>
            <p>
              Caminata segura con correa holgada por rutas previamente revisadas en Foresta. Estimulación olfativa enriquecedora, paradas para tomar agua fresca limpia y recolección responsable de heces en bolsas biodegradables.
            </p>
          </div>
        </div>

        <!-- Paso 4 -->
        <div class="timeline-item">
          <div class="timeline-dot">4</div>
          <div class="timeline-card">
            <div class="timeline-card-header">
              <span class="timeline-time-badge">Reporte inmediato</span>
            </div>
            <h3>Regreso Seguro y Reporte Completo</h3>
            <p>
              Entregamos a tu perro en tu puerta, limpiamos sus patitas si el piso estaba húmedo, verificamos que tenga agua limpia en su tazón y te enviamos su reporte con hora, duración, detalles y foto autorizada.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ================= 4. INFORMACIÓN REQUERIDA Y SEGURIDAD ================= -->
  <section class="section-wrapper section-alt" id="requisitos">
    <div class="container">
      <div class="grid-2 requirements-grid">
        <!-- Requisitos Previos -->
        <div class="card req-card">
          <h3 class="req-title">¿Qué información y equipo solicitamos antes del primer paseo?</h3>
          <p class="req-intro">
            Antes de la primera salida revisamos contigo su cartilla de vacunación, el ajuste del arnés y los datos de contacto para una emergencia:
          </p>

          <ul class="req-list">
            <li>
              <div class="req-icon-box">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
                </svg>
              </div>
              <div>
                <strong>Cartilla de vacunación y desparasitación</strong>
                <p>Esquema básico al día (rabia, séxtuple/múltiple y desparasitación vigente).</p>
              </div>
            </li>
            <li>
              <div class="req-icon-box">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <circle cx="12" cy="12" r="10"></circle>
                  <circle cx="12" cy="12" r="3"></circle>
                </svg>
              </div>
              <div>
                <strong>Arnés o pechera adecuada</strong>
                <p>Requerimos arnés ergonómico en buen estado y placa de identificación con teléfono legible. No utilizamos collares de castigo ni de púas.</p>
              </div>
            </li>
            <li>
              <div class="req-icon-box">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
                </svg>
              </div>
              <div>
                <strong>Contacto de emergencia y veterinario</strong>
                <p>Número de tu médico veterinario de cabecera y una persona de contacto alterna en caso de no localizarte de inmediato.</p>
              </div>
            </li>
            <li>
              <div class="req-icon-box">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                  <polyline points="14 2 14 8 20 8"></polyline>
                </svg>
              </div>
              <div>
                <strong>Instrucciones particulares</strong>
                <p>Alergias conocidas, si toma alguna medicina o si tiene fobia a estímulos comunes (como motos o truenos).</p>
              </div>
            </li>
          </ul>

          <div class="req-card-footer">
            <span class="req-footer-highlight">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
              Lo revisamos contigo antes de la primera salida
            </span>
          </div>
        </div>

        <!-- Protocolo de Seguridad y Clima -->
        <div class="card req-card">
          <Image class="care-photo" src={restMoment} alt="Dos perros descansando juntos a la sombra en un camino" loading="lazy" widths={[400,700,1000]} sizes="(max-width: 699px) 100vw, 50vw" />
          <h3 class="req-title">Seguridad y Adaptación Climática</h3>
          <p class="req-intro">
            Las condiciones ambientales cambian y la integridad física de tu mascota es lo primero:
          </p>

          <div class="safety-points-wrap">
            <div class="safety-item">
              <h4>Manejo de Calor y Prueba de Asfalto</h4>
              <p>
                En días soleados realizamos la prueba táctil de 7 segundos en el pavimento antes de caminar. Si el asfalto quema, buscamos exclusivamente áreas verdes con pasto, sombras arboladas o reprogramamos a la mañana o tarde fresca.
              </p>
            </div>

            <div class="safety-item">
              <h4>Lluvias Fuertes o Tormentas</h4>
              <p>
                Ante lluvia torrencial con truenos pausamos el paseo en zonas cubiertas para evitar crisis de miedo y coordinamos contigo la reposición del tiempo o reagendamiento por WhatsApp.
              </p>
            </div>

            <div class="safety-item">
              <h4>Hidratación y Descansos</h4>
              <p>
                Portamos agua potable fresca y bebederos portátiles limpios para ofrecer pausas de hidratación en cada trayecto.
              </p>
            </div>

            <div class="safety-item">
              <h4>Fotografía Ética y Autorizada</h4>
              <p>
                Solo tomamos fotografías de tu perro si tú nos autorizas previamente. Las fotos son exclusivamente para tu reporte personal o fines acordados.
              </p>
            </div>
          </div>

          <div class="req-card-footer">
            <span class="req-footer-highlight">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
              Protocolo de prevención activa en senderos de Foresta
            </span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ================= 5. PREGUNTAS FRECUENTES ================= -->
  <section class="section-wrapper section-surface" id="faq">
    <div class="container">
      <div class="section-header">
        <h2>¿Cuáles son las dudas más frecuentes sobre los paseos?</h2>
        <p>
          Respondemos con claridad cómo coordinamos horarios, qué pasa ante lluvia y cómo recibirás el reporte de tu perro por WhatsApp.
        </p>
      </div>

      <FAQAccordion />
      <FaqSchema />

      <div class="faq-extra-help">
        <p>¿Tienes una duda particular que no ves aquí?</p>
        <WhatsAppButton
          context="faq"
          text="Pregúntanos por WhatsApp"
          variant="outline"
          size="md"
        />
      </div>
    </div>
  </section>

  <!-- ================= 6. CTA FINAL ================= -->
  <section class="section-wrapper final-cta-section">
    <div class="container">
      <div class="final-cta-card">
        <div class="cta-inner-content">
          <h2 class="final-cta-title">
            Empecemos por conocer a tu perro.
          </h2>
          <p class="final-cta-desc">
            Cuéntanos su edad, cómo suele llevarse con otros perros y qué horarios necesitas. Te compartimos opciones y tarifas antes de coordinar su primera salida.
          </p>
          <div class="cta-buttons-wrap">
            <WhatsAppButton
              context="paseosPage"
              text="Consultar horarios y tarifas"
              variant="primary"
              size="lg"
              id="paseos-final-cta"
            />
            <a href="/" class="btn btn-secondary btn-lg">
              Regresar al Inicio
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .care-photo { width: 100%; height: 240px; object-fit: cover; border-radius: 4px; margin-bottom: 8px; }
  .page-hero { padding: 56px 0 64px; background: white; }
  .page-hero-container { display: grid; grid-template-columns: minmax(0,1fr) minmax(0,1fr); gap: 64px; align-items: center; }
  .page-hero-text { display: flex; flex-direction: column; gap: 24px; }
  .page-hero-title { font-size: clamp(3.8rem,6.8vw,6rem); line-height: .98; letter-spacing: -.04em; }
  .text-highlight { display: block; color: var(--brand-wine); font: 500 1rem/1.5 var(--font-sans); letter-spacing: 0; margin-top: 24px; }
  .page-hero-text .lead { font-size: 1.05rem; line-height: 1.75; max-width: 44ch; }
  .page-hero-ctas { display: flex; align-items: center; flex-wrap: wrap; gap: 12px 24px; }
  .page-hero :global(.btn-primary) { background: var(--brand-orange); color: var(--color-on-orange); }
  .page-hero :global(.btn-primary:hover) { background: var(--brand-cream); color: var(--brand-wine); }
  :global(.page-hero .btn) { border-radius: 12px; white-space: normal; }
  .page-hero-ctas > a { padding: 12px 0; border: 0; border-radius: 0; background: none; box-shadow: none; color: var(--brand-wine); font-size: 1rem; text-decoration: underline; text-underline-offset: 6px; }
  .page-hero-media { position: relative; padding-bottom: 24px; }
  .page-hero-img { width: 100%; height: 560px; object-fit: cover; object-position: center 45%; border-radius: 120px 4px 4px 4px; }
  .hero-photo-note { position: absolute; bottom: 0; left: -32px; padding: 24px; background: var(--brand-cream); color: var(--brand-wine); font: 500 1.7rem/1.2 var(--font-heading); }
