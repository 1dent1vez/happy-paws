---
import { siteConfig } from '../config/site';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  currentPath?: string;
  ogImage?: string;
}

const {
  title = `${siteConfig.name} — Paseos en Foresta Dream Lagoons`,
  description = siteConfig.description,
  currentPath = '/',
  ogImage = '/images/og-cover.jpg'
} = Astro.props;

// `new URL('/paseos', base)` normaliza a '/paseos' y se come el slash final,
// mientras que Astro con trailingSlash:'always' sirve '/paseos/'. El canonical
// debe coincidir con la URL realmente servida o se emiten dos canónicas para
// la misma página. Las rutas internas ya llegan con slash; se garantiza aquí.
const normalizedPath =
  currentPath === '/' ? '/' : currentPath.replace(/\/?$/, '/');

const canonicalUrl = new URL(normalizedPath, siteConfig.url).href;
const fullOgImageUrl = new URL(ogImage, siteConfig.url).href;

// LocalBusiness: postalAddress y geo eran los campos que faltaban para que
// Google asociara el negocio a Metepec en búsquedas locales. Sin ellos el
// snippet queda genérico y no compite por "paseos para perros Metepec".
const schemaData = {
  '@context': 'https://schema.org',
  '@type': 'LocalBusiness',
  'name': siteConfig.name,
  'legalName': siteConfig.legalName,
  'description': siteConfig.description,
  'url': siteConfig.url,
  'telephone': siteConfig.whatsapp.phoneFormatted,
  'image': fullOgImageUrl,
  'priceRange': '$$',
  'currenciesAccepted': 'MXN',
  'address': {
    '@type': 'PostalAddress',
    'addressLocality': siteConfig.coverage.city,
    'addressRegion': siteConfig.coverage.state,
    'addressCountry': 'MX'
  },
  'geo': {
    '@type': 'GeoCoordinates',
    'latitude': siteConfig.coverage.latitude,
    'longitude': siteConfig.coverage.longitude
  },
  'areaServed': {
    '@type': 'Place',
    'name': siteConfig.coverage.community
  },
  'openingHoursSpecification': [
    {
      '@type': 'OpeningHoursSpecification',
      'dayOfWeek': ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday'],
      'opens': siteConfig.schedule.opens,
      'closes': siteConfig.schedule.closes
    }
  ]
};
---

<!DOCTYPE html>
<html lang="es-MX">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <!-- Logo oficial: cuadrado PNG con el perro completo y centrado -->
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/favicon-180.png" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <meta name="generator" content={Astro.generator} />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={fullOgImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={siteConfig.tagline} />
    <meta property="og:site_name" content={siteConfig.name} />
    <meta property="og:locale" content="es_MX" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalUrl} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={fullOgImageUrl} />

    <!-- Tipografía: Plus Jakarta Sans auto-alojada. Sin petición a Google Fonts
         en la ruta crítica de render y sin terceros en la request inicial.
         Es una fuente variable: un woff2 cubre los pesos 400-800. -->
    <link
      rel="preload"
      href="/fonts/plus-jakarta-sans-latin-variable.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link rel="stylesheet" href="/fonts/plus-jakarta-sans.css" />

    <!-- Structured Data JSON-LD -->
    <script type="application/ld+json" set:html={JSON.stringify(schemaData)} />
    <slot name="head" />
  </head>
  <body>
    <!-- Skip to main content -->
    <a href="#main-content" class="skip-link">Saltar al contenido principal</a>


    <!-- Global Header -->
    <Header />

    <!-- Main Content Landmark -->
    <main id="main-content">
      <slot />
    </main>

    <!-- Global Footer -->
    <Footer />

    <!-- Floating WhatsApp conversion button -->
    <WhatsAppButton
      context="floating"
      text="Consultar por WhatsApp"
      variant="whatsapp"
      className="floating-whatsapp"
      id="floating-cta"
      ariaLabel="Consultar paseos por WhatsApp"
    />
  </body>
</html>

<script>
  // Un único listener delegado mide todos los clics a WhatsApp de la página,
  // incluidos los que el JS del hero genera en tiempo de ejecución.
  import { initConversionTracking } from '../lib/tracking';

  initConversionTracking();
</script>

<style>
  .skip-link {
    position: absolute;
    top: -50px;
    left: 10px;
    background: var(--color-primary);
    color: #fff;
    padding: 10px 16px;
    z-index: 999;
    font-weight: 700;
    border-radius: var(--radius-md);
    transition: top var(--transition-fast);
  }

  .skip-link:focus {
    top: 10px;
  }
</style>
