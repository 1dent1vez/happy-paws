---
import { siteConfig } from '../config/site';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  currentPath?: string;
  ogImage?: string;
  noindex?: boolean;
}

const {
  title = `${siteConfig.name} Metepec | Paseos de Perros en Foresta Dream Lagoons`,
  description = siteConfig.description,
  currentPath = '/',
  ogImage = '/images/og-image.jpg',
  noindex = false
} = Astro.props;

// `new URL('/paseos', base)` normaliza a '/paseos' y se come el slash final,
// mientras que Astro con trailingSlash:'always' sirve '/paseos/'. El canonical
// debe coincidir con la URL realmente servida o se emiten dos canónicas para
// la misma página. Las rutas internas ya llegan con slash; se garantiza aquí.
const normalizedPath =
  currentPath === '/' ? '/' : currentPath.replace(/\/?$/, '/');

const canonicalUrl = new URL(normalizedPath, siteConfig.url).href;
const fullOgImageUrl = new URL(ogImage, siteConfig.url).href;

// Public business and service information, consistent with visible coverage.
const schemaData = {
  '@context': 'https://schema.org',
  '@type': 'LocalBusiness',
  '@id': `${siteConfig.url}/#business`,
  'name': siteConfig.name,
  'legalName': siteConfig.legalName,
  'description': siteConfig.description,
  'url': siteConfig.url,
  'sameAs': [
    siteConfig.instagram.url
  ],
  'telephone': siteConfig.whatsapp.phoneFormatted,
  'image': fullOgImageUrl,
  // schema.org exige URL absoluta para `logo`
  'logo': new URL('/images/logo-full.png', siteConfig.url).href,
  'currenciesAccepted': 'MXN',
  'paymentAccepted': 'Efectivo, Transferencia',
  'address': {
    '@type': 'PostalAddress',
    'addressLocality': siteConfig.coverage.city,
    'addressRegion': siteConfig.coverage.state,
    'addressCountry': 'MX'
  },
  // Service area, not a public storefront or an unverified map pin.
  'areaServed': {
    '@type': 'Place',
    'name': siteConfig.coverage.community,
    'address': {
      '@type': 'PostalAddress',
      'addressLocality': siteConfig.coverage.city,
      'addressRegion': siteConfig.coverage.state,
      'addressCountry': 'MX'
    }
  },
  'openingHoursSpecification': [
    {
      '@type': 'OpeningHoursSpecification',
      'dayOfWeek': ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday'],
      'opens': siteConfig.schedule.opens,
      'closes': siteConfig.schedule.closes
    }
  ],
  'hasOfferCatalog': {
    '@type': 'OfferCatalog',
    'name': 'Servicios de Paseo Canino',
    'itemListElement': [
      {
        '@type': 'Offer',
        'itemOffered': {
          '@type': 'Service',
          '@id': `${siteConfig.url}/paseos/#individual`,
          'name': 'Paseo individual de perros en Foresta',
          'serviceType': 'Paseo individual de perros',
          'provider': { '@id': `${siteConfig.url}/#business` },
          'areaServed': { '@type': 'Place', 'name': siteConfig.coverage.community },
          'description': 'Paseo exclusivo 1 a 1 de 45 a 60 minutos con estimulación olfativa guiada y reporte con fotos en Foresta Dream Lagoons.'
        }
      },
      {
        '@type': 'Offer',
        'itemOffered': {
          '@type': 'Service',
          '@id': `${siteConfig.url}/paseos/#grupal`,
          'name': 'Paseo grupal de perros en Foresta',
          'serviceType': 'Paseo grupal de perros',
          'provider': { '@id': `${siteConfig.url}/#business` },
          'areaServed': { '@type': 'Place', 'name': siteConfig.coverage.community },
          'description': 'Paseo en manadas pequeñas de hasta 4 perros por paseador con temperamentos compatibles evaluados en Foresta Dream Lagoons.'
        }
      }
    ]
  },
  'contactPoint': {
    '@type': 'ContactPoint',
    'contactType': 'customer service',
    'telephone': siteConfig.whatsapp.phoneFormatted,
    'availableLanguage': ['Spanish']
  }
};
const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    schemaData,
    {
      '@type': 'WebSite',
      '@id': `${siteConfig.url}/#website`,
      'url': `${siteConfig.url}/`,
      'name': `${siteConfig.name} Metepec`,
      'inLanguage': siteConfig.locale,
      'publisher': { '@id': `${siteConfig.url}/#business` }
    },
    {
      '@type': 'WebPage',
      '@id': `${canonicalUrl}#webpage`,
      'url': canonicalUrl,
      'name': title,
      'description': description,
      'inLanguage': siteConfig.locale,
      'isPartOf': { '@id': `${siteConfig.url}/#website` },
      'about': { '@id': `${siteConfig.url}/#business` }
    }
  ]
};
---

<!DOCTYPE html>
<html lang="es-MX">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex ? (
      <meta name="robots" content="noindex, nofollow" />
    ) : (
      <meta name="robots" content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1" />
    )}
    <link rel="canonical" href={canonicalUrl} />
    <!-- Logo oficial: cuadrado PNG con el perro completo y centrado -->
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/favicon-180.png" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <!-- Integración al añadir a inicio en iOS/Android. Sin theme-color la
         barra del sistema queda en blanco por defecto y desentona con la
         paleta cálida del sitio. -->
    <meta name="theme-color" content="#FCF4F0" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta name="generator" content={Astro.generator} />
    <meta name="google-site-verification" content="5Dk3ll1ettT9O3bXnJPdYqaH1ztI4gmPv9ujOBz9SiI" />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={fullOgImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={siteConfig.tagline} />
    <meta property="og:site_name" content={siteConfig.name} />
    <meta property="og:locale" content="es_MX" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalUrl} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={fullOgImageUrl} />

    <!-- Local variable fonts: no third-party font requests at runtime. -->
    <link rel="preload" href="/fonts/fraunces-latin-variable.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/manrope-latin-variable.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="stylesheet" href="/fonts/brand-fonts.css" />

    <!-- Structured Data JSON-LD -->
    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
    <slot name="head" />
  </head>
  <body>
    <!-- Skip to main content -->
    <a href="#main-content" class="skip-link">Saltar al contenido principal</a>


    <!-- Global Header -->
    <Header />

    <!-- Main Content Landmark -->
    <main id="main-content">
      <slot />
    </main>

    <!-- Global Footer -->
    <Footer />

    <!-- Floating WhatsApp conversion button -->
    <WhatsAppButton
      context="floating"
      text="Consultar por WhatsApp"
      variant="whatsapp"
      className="floating-whatsapp"
      id="floating-cta"
      ariaLabel="Consultar paseos por WhatsApp"
    />
  </body>
</html>

<script>
  // Un único listener delegado mide todos los clics a WhatsApp de la página,
  // incluidos los que el JS del hero genera en tiempo de ejecución.
  import { initConversionTracking } from '../lib/tracking';

  initConversionTracking();

  // Keep the global CTA out of the hero; reveal it below the sticky header.
  const floatingCta = document.getElementById('floating-cta');
  const hero = document.querySelector('[data-page-hero], .hero-fullscreen, .page-hero');
  const header = document.getElementById('site-header');

  if (floatingCta) {
    const actualizar = () => {
      const heroFuera = !hero || hero.getBoundingClientRect().bottom <= (header?.getBoundingClientRect().bottom ?? 0);
      const headerBottom = header?.getBoundingClientRect().bottom ?? 0;
      const ownCtaVisible = Array.from(document.querySelectorAll<HTMLElement>('main a[data-hp-context], footer a[data-hp-context]')).some((link) => {
        const rect = link.getBoundingClientRect();
        return rect.width > 0 && rect.height > 0 && rect.top >= headerBottom && rect.bottom <= window.innerHeight;
      });
      const menuOpen = document.getElementById('mobile-toggle')?.getAttribute('aria-expanded') === 'true';
      const planner = document.querySelector<HTMLDetailsElement>('.optional-planner[open]');
      const plannerRect = planner?.getBoundingClientRect();
      const plannerVisible = Boolean(plannerRect && plannerRect.top < window.innerHeight && plannerRect.bottom > headerBottom);
      const visible = heroFuera && !ownCtaVisible && !menuOpen && !plannerVisible;
      floatingCta.classList.toggle('is-visible', visible);
      floatingCta.inert = !visible;
      floatingCta.setAttribute('aria-hidden', String(!visible));
    };
    let pendiente = false;
    const alScroll = () => {
      if (pendiente) return;
      pendiente = true;
      requestAnimationFrame(() => {
        pendiente = false;
        actualizar();
      });
    };
    window.addEventListener('scroll', alScroll, { passive: true });
    window.addEventListener('resize', alScroll, { passive: true });
    window.addEventListener('pageshow', actualizar);
    document.addEventListener('click', alScroll);
    document.addEventListener('change', alScroll);
    document.addEventListener('toggle', alScroll, true);
    actualizar();
  }

</script>

<style>
  .skip-link {
    position: absolute;
    top: -50px;
    left: 10px;
    background: var(--brand-wine);
    color: #fff;
    padding: 10px 16px;
    z-index: 999;
    font-weight: 700;
    border-radius: var(--radius-md);
    transition: top var(--transition-fast);
  }

  .skip-link:focus {
    top: 10px;
  }
</style>
