---
import { siteConfig } from '../config/site';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  currentPath?: string;
  ogImage?: string;
  noindex?: boolean;
}

const {
  title = `${siteConfig.name} — Paseos en Foresta Dream Lagoons`,
  description = siteConfig.description,
  currentPath = '/',
  ogImage = '/images/og-cover.jpg',
  noindex = false
} = Astro.props;

// `new URL('/paseos', base)` normaliza a '/paseos' y se come el slash final,
// mientras que Astro con trailingSlash:'always' sirve '/paseos/'. El canonical
// debe coincidir con la URL realmente servida o se emiten dos canónicas para
// la misma página. Las rutas internas ya llegan con slash; se garantiza aquí.
const normalizedPath =
  currentPath === '/' ? '/' : currentPath.replace(/\/?$/, '/');

const canonicalUrl = new URL(normalizedPath, siteConfig.url).href;
const fullOgImageUrl = new URL(ogImage, siteConfig.url).href;

// LocalBusiness: postalAddress y geo eran los campos que faltaban para que
// Google asociara el negocio a Metepec en búsquedas locales. Sin ellos el
// snippet queda genérico y no compite por "paseos para perros Metepec".
const schemaData = {
  '@context': 'https://schema.org',
  '@type': 'LocalBusiness',
  'name': siteConfig.name,
  'legalName': siteConfig.legalName,
  'description': siteConfig.description,
  'url': siteConfig.url,
  'telephone': siteConfig.whatsapp.phoneFormatted,
  'image': fullOgImageUrl,
  // schema.org exige URL absoluta para `logo`; con ruta relativa Google la
  // descarta. Se usa el lockup completo (perro + "PAWS") que es la marca oficial.
  'logo': new URL('/images/logo-full.png', siteConfig.url).href,
  'priceRange': '$$',
  'currenciesAccepted': 'MXN',
  'address': {
    '@type': 'PostalAddress',
    'addressLocality': siteConfig.coverage.city,
    'addressRegion': siteConfig.coverage.state,
    'addressCountry': 'MX'
  },
  'geo': {
    '@type': 'GeoCoordinates',
    'latitude': siteConfig.coverage.latitude,
    'longitude': siteConfig.coverage.longitude
  },
  'areaServed': {
    '@type': 'Place',
    'name': siteConfig.coverage.community
  },
  'openingHoursSpecification': [
    {
      '@type': 'OpeningHoursSpecification',
      'dayOfWeek': ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday'],
      'opens': siteConfig.schedule.opens,
      'closes': siteConfig.schedule.closes
    }
  ]
};
---

<!DOCTYPE html>
<html lang="es-MX">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={canonicalUrl} />
    <!-- Logo oficial: cuadrado PNG con el perro completo y centrado -->
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/favicon-180.png" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <!-- Integración al añadir a inicio en iOS/Android. Sin theme-color la
         barra del sistema queda en blanco por defecto y desentona con la
         paleta cálida del sitio. -->
    <meta name="theme-color" content="#FAF7F2" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta name="generator" content={Astro.generator} />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={fullOgImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={siteConfig.tagline} />
    <meta property="og:site_name" content={siteConfig.name} />
    <meta property="og:locale" content="es_MX" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalUrl} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={fullOgImageUrl} />

    <!-- Tipografía: Outfit (Moderno, cálido y geométrico) + Plus Jakarta Sans como respaldo -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />
    <link
      rel="preload"
      href="/fonts/plus-jakarta-sans-latin-variable.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link rel="stylesheet" href="/fonts/plus-jakarta-sans.css" />

    <!-- Structured Data JSON-LD -->
    <script type="application/ld+json" set:html={JSON.stringify(schemaData)} />
    <slot name="head" />
  </head>
  <body>
    <!-- Skip to main content -->
    <a href="#main-content" class="skip-link">Saltar al contenido principal</a>


    <!-- Global Header -->
    <Header />

    <!-- Main Content Landmark -->
    <main id="main-content">
      <slot />
    </main>

    <!-- Global Footer -->
    <Footer />

    <!-- Floating WhatsApp conversion button -->
    <WhatsAppButton
      context="floating"
      text="Consultar por WhatsApp"
      variant="whatsapp"
      className="floating-whatsapp"
      id="floating-cta"
      ariaLabel="Consultar paseos por WhatsApp"
    />
  </body>
</html>

<script>
  // Un único listener delegado mide todos los clics a WhatsApp de la página,
  // incluidos los que el JS del hero genera en tiempo de ejecución.
  import { initConversionTracking } from '../lib/tracking';

  initConversionTracking();

  // El CTA flotante compite con la omnibar mientras el usuario está en el
  // hero, así que se mantiene oculto hasta que el hero queda fuera de
  // pantalla. Se usa un listener de scroll con rAF en lugar de
  // IntersectionObserver porque el umbral exacto ("el hero ya no se ve")
  // necesita la posición real del elemento, y así se evita depender de que
  // el umbral de intersección se calcule como se espera.
  const floatingCta = document.getElementById('floating-cta');
  const hero = document.querySelector('.hero-fullscreen, .page-hero');

  if (floatingCta) {
    // Sin hero (páginas legales, 404) no hay CTA con el que competir: visible.
    if (!hero) {
      floatingCta.classList.add('is-visible');
    } else {
      let pendiente = false;

      const actualizar = () => {
        pendiente = false;
        // El hero ocupa toda la pantalla inicial; cuando su borde inferior
        // pasa de 0 es que quedó completamente fuera de vista.
        const heroFuera = hero.getBoundingClientRect().bottom <= 0;
        floatingCta.classList.toggle('is-visible', heroFuera);
      };

      const alScroll = () => {
        if (pendiente) return;
        pendiente = true;
        requestAnimationFrame(actualizar);
      };

      window.addEventListener('scroll', alScroll, { passive: true });
      window.addEventListener('resize', alScroll, { passive: true });
      actualizar();
    }
  }
</script>

<style>
  .skip-link {
    position: absolute;
    top: -50px;
    left: 10px;
    background: var(--color-primary);
    color: #fff;
    padding: 10px 16px;
    z-index: 999;
    font-weight: 700;
    border-radius: var(--radius-md);
    transition: top var(--transition-fast);
  }

  .skip-link:focus {
    top: 10px;
  }
</style>
