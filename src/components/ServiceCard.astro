---
import WhatsAppButton from './WhatsAppButton.astro';

interface Props {
  type: 'individual' | 'group';
  badge: string;
  title: string;
  tagline: string;
  description: string;
  idealFor: string;
  features: string[];
  imageSrc: string;
  imageAlt: string;
  ctaText?: string;
  featured?: boolean;
}

const {
  type,
  badge,
  title,
  tagline,
  description,
  idealFor,
  features,
  imageSrc,
  imageAlt,
  ctaText = 'Consultar disponibilidad',
  featured = false
} = Astro.props;

const contextKey = type === 'individual' ? 'individual' : 'group';
---

<div class={`service-card ${featured ? 'service-card-featured' : ''}`}>
  <div class="card-image-wrap">
    <img src={imageSrc} alt={imageAlt} loading="lazy" class="service-img" />
    <span class="service-badge">{badge}</span>
  </div>

  <div class="card-content">
    <div class="card-header">
      <h3 class="service-title">{title}</h3>
      <p class="service-tagline">{tagline}</p>
    </div>

    <p class="service-desc">{description}</p>

    <div class="ideal-box">
      <span class="ideal-label">Recomendado para:</span>
      <span class="ideal-text">{idealFor}</span>
    </div>

    <div class="features-block">
      <h4 class="features-heading">¿Qué incluye esta modalidad?</h4>
      <ul class="features-list">
        {features.map((feature) => (
          <li>
            <svg class="check-icon" width="18" height="18" viewBox="0 0 20 20" fill="none" aria-hidden="true">
              <circle cx="10" cy="10" r="10" fill="#E8F8EE"/>
              <path d="M6 10.5L8.5 13L14 7.5" stroke="#15803D" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
            <span>{feature}</span>
          </li>
        ))}
      </ul>
    </div>

    <div class="card-footer">
      <p class="pricing-hint">
        Tarifas, duración y cupos se confirman por WhatsApp según zona y necesidades.
      </p>
      <WhatsAppButton
        context={contextKey}
        text={ctaText}
        variant={featured ? 'primary' : 'whatsapp'}
        size="md"
        className="w-full"
        id={`cta-${type}`}
      />
    </div>
  </div>
</div>

<style>
  .service-card {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xl);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    box-shadow: var(--shadow-sm);
    transition: transform var(--transition-normal), box-shadow var(--transition-normal), border-color var(--transition-normal);
  }

  .service-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-xl);
    border-color: var(--color-primary-border);
  }

  .service-card-featured {
    border-color: var(--color-primary);
    box-shadow: var(--shadow-md);
    position: relative;
  }

  .service-card-featured::before {
    content: 'Opción Más Solicitada';
    position: absolute;
    top: 16px;
    right: 16px;
    z-index: 10;
    background-color: var(--color-primary);
    color: #fff;
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    padding: 4px 12px;
    border-radius: var(--radius-full);
    box-shadow: var(--shadow-sm);
  }

  .card-image-wrap {
    position: relative;
    width: 100%;
    height: 240px;
    overflow: hidden;
  }

  .service-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--transition-smooth);
  }

  .service-card:hover .service-img {
    transform: scale(1.04);
  }

  .service-badge {
    position: absolute;
    bottom: 14px;
    left: 14px;
    background-color: rgba(28, 25, 23, 0.85);
    backdrop-filter: blur(8px);
    color: #fff;
    font-size: 0.8rem;
    font-weight: 700;
    padding: 4px 12px;
    border-radius: var(--radius-full);
  }

  .card-content {
    padding: var(--space-8);
    display: flex;
    flex-direction: column;
    flex-grow: 1;
    gap: var(--space-5);
  }

  .service-title {
    font-size: 1.5rem;
    margin-bottom: var(--space-1);
    color: var(--color-text-title);
  }

  .service-tagline {
    font-size: 0.95rem;
    color: var(--color-primary);
    font-weight: 600;
  }

  .service-desc {
    font-size: 0.95rem;
    line-height: 1.6;
    color: var(--color-text-muted);
  }

  .ideal-box {
    background-color: var(--color-bg);
    border: 1px solid var(--color-border-subtle);
    border-radius: var(--radius-md);
    padding: var(--space-3) var(--space-4);
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .ideal-label {
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-text-subtle);
  }

  .ideal-text {
    font-size: 0.9rem;
    color: var(--color-text);
    font-weight: 500;
  }

  .features-block {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    margin-top: auto;
  }

  .features-heading {
    font-size: 0.9rem;
    font-weight: 700;
    color: var(--color-text-title);
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .features-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .features-list li {
    display: flex;
    align-items: flex-start;
    gap: var(--space-3);
    font-size: 0.925rem;
    color: var(--color-text);
    line-height: 1.45;
  }

  .check-icon {
    flex-shrink: 0;
    margin-top: 2px;
  }

  .card-footer {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    padding-top: var(--space-4);
    border-top: 1px solid var(--color-border);
  }

  .pricing-hint {
    font-size: 0.8rem;
    color: var(--color-text-subtle);
    text-align: center;
    line-height: 1.4;
  }

  .w-full {
    width: 100%;
  }
</style>
