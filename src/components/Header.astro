    top: 0;
    z-index: 90;
    background-color: rgba(250, 247, 242, 0.88);
    backdrop-filter: blur(16px) saturate(180%);
    -webkit-backdrop-filter: blur(16px) saturate(180%);
    border-bottom: 1px solid var(--color-border);
    box-shadow: 0 1px 4px rgba(28, 25, 23, 0.03);
    transition: background-color var(--transition-normal), box-shadow var(--transition-normal);
  }

  .header-container {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: var(--header-height);
  }

  .brand-logo {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    text-decoration: none;
    transition: transform var(--transition-fast);
  }

  .brand-logo:hover {
    transform: translateY(-1px);
  }

  .logo-mark {
    display: flex;
    align-items: center;
    justify-content: center;
  }

  /* El logo oficial es un PNG alargado (perro sobre "PAWS"); se respeta su
     proporcion real (2.22:1) y se limita la altura para no desbordar el header. */
  .logo-img {
    height: 34px;
    width: auto;
    flex-shrink: 0;
    object-fit: contain;
  }

  .brand-title-wrap {
    display: flex;
    flex-direction: column;
  }

  .brand-name {
    font-size: 1.25rem;
    font-weight: 800;
    letter-spacing: -0.02em;
    color: var(--color-text-title);
    line-height: 1.1;
  }

  .location-badge {
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--color-primary-action);
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  .desktop-nav {
    display: block;
  }

  .nav-list {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    list-style: none;
  }

  .nav-link {
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--color-text-muted);
    padding: 6px 14px;
    border-radius: var(--radius-full);
    transition: all var(--transition-fast);
  }

  .nav-link:hover {
    color: var(--color-primary-action);
    background-color: var(--color-primary-light);
  }

  .header-action {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }

  .mobile-menu-toggle {
    display: none;
    flex-direction: column;
    justify-content: space-around;
    width: 44px;
    height: 44px;
    min-width: 44px;
    min-height: 44px;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    cursor: pointer;
    padding: 11px 9px;
    transition: background-color var(--transition-fast), border-color var(--transition-fast);
  }

  .mobile-menu-toggle:hover {
    background-color: var(--color-primary-light);
    border-color: var(--color-primary-border);
  }

  .hamburger-bar {
    width: 100%;
    height: 2px;
    background-color: var(--color-text-title);
    border-radius: var(--radius-full);
    transition: all var(--transition-normal);
  }

  .mobile-menu-toggle.is-active .hamburger-bar:nth-child(1) {
    transform: translateY(6px) rotate(45deg);
  }

  .mobile-menu-toggle.is-active .hamburger-bar:nth-child(2) {
    opacity: 0;
  }

  .mobile-menu-toggle.is-active .hamburger-bar:nth-child(3) {
    transform: translateY(-6px) rotate(-45deg);
  }

  .mobile-nav-drawer {
    display: none;
  }

  @media (max-width: 860px) {
    .desktop-nav {
      display: none;
    }

    .mobile-menu-toggle {
      display: flex;
    }

    .mobile-nav-drawer {
      display: block;
      max-height: 0;
      overflow: hidden;
      background: rgba(255, 255, 255, 0.98);
      backdrop-filter: blur(16px);
      border-bottom: 1px solid var(--color-border);
      box-shadow: var(--shadow-lg);
      transition: max-height var(--transition-normal) ease-in-out;
    }

    .mobile-nav-drawer.is-open {
