      border-radius: var(--radius-md);
      transition: background-color var(--transition-fast), color var(--transition-fast);
    }

    .mobile-link:hover,
    .mobile-link:active {
      background-color: var(--color-primary-light);
      color: var(--color-primary-action);
    }
  }

  @media (max-width: 480px) {
    .brand-name {
      font-size: 1.15rem;
    }

    .location-badge {
      font-size: 0.7rem;
    }

    .logo-img {
      height: 30px;
    }
  }

  .w-full {
    width: 100%;
  }
</style>
