<header class="site-header" id="site-header">
  <div class="container header-container">
    <a href="/" class="brand-logo" aria-label="Happy Paws - Inicio">
      <img
        src="/images/logo-mark.png"
        alt=""
        width="52"
        height="23"
        class="logo-img"
        aria-hidden="true"
      />
      <div class="brand-title-wrap">
        <span class="brand-name">Happy Paws</span>
        <span class="location-badge">Foresta Dream Lagoons</span>
      </div>
    </a>

    <!-- Minimal Clean Navigation -->
    <nav class="desktop-nav" aria-label="Navegación principal">
      <ul class="nav-list">
        <li>
          <a href="/#beneficios" class="nav-link">Beneficios</a>
        </li>
        <li>
          <a href="/#como-funciona" class="nav-link">Cómo Funciona</a>
        </li>
        <li>
          <a href="/#faq" class="nav-link">Preguntas Frecuentes</a>
        </li>
      </ul>
    </nav>

    <!-- Header Direct Action -->
    <div class="header-action">
      <!-- Mobile Menu Button -->
      <button
        type="button"
        class="mobile-menu-toggle"
        id="mobile-toggle"
        aria-expanded="false"
        aria-controls="mobile-nav"
        aria-label="Abrir menú"
      >
        <span class="hamburger-bar"></span>
        <span class="hamburger-bar"></span>
        <span class="hamburger-bar"></span>
      </button>
    </div>
  </div>

  <!-- Mobile Clean Drawer -->
  <!-- `inert` mientras está cerrado: sin él los enlaces siguen siendo focusables
       por teclado aunque aria-hidden="true" y max-height:0 los oculten, así que
       un lector de pantalla y el tabulador llegan a contenido "invisible".
       El atributo se mantiene sincronizado desde el script de abajo. -->
  <div class="mobile-nav-drawer" id="mobile-nav" aria-hidden="true" inert>
    <nav class="mobile-nav-links" aria-label="Navegación móvil">
      <a href="/#beneficios" class="mobile-link">Beneficios para tu Mascota</a>
      <a href="/#como-funciona" class="mobile-link">Cómo Funciona</a>
      <a href="/#faq" class="mobile-link">Preguntas Frecuentes</a>

    </nav>
  </div>
</header>

<script>
  const toggleBtn = document.getElementById('mobile-toggle');
  const mobileNav = document.getElementById('mobile-nav');

  /** `inert` es lo que saca al drawer del orden de tabulación cuando está
   *  cerrado; `aria-hidden` solo lo anuncia. Hay que mantener ambos en sync. */
  const setOpen = (open: boolean) => {
    toggleBtn?.setAttribute('aria-expanded', String(open));
    mobileNav?.setAttribute('aria-hidden', String(!open));
    mobileNav?.classList.toggle('is-open', open);
    toggleBtn?.classList.toggle('is-active', open);
    if (open) {
      mobileNav?.removeAttribute('inert');
    } else {
      mobileNav?.setAttribute('inert', '');
    }
  };

  if (toggleBtn && mobileNav) {
    toggleBtn.addEventListener('click', () => {
      const isExpanded = toggleBtn.getAttribute('aria-expanded') === 'true';
      setOpen(!isExpanded);
    });

    // Cerrar al elegir un destino: en una landing de una sola página el
    // drawer abierto tapa el contenido al que se acaba de saltar.
    mobileNav.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', () => setOpen(false));
    });

    // Escape cierra el drawer, igual que los popovers del hero.
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && toggleBtn.getAttribute('aria-expanded') === 'true') {
        setOpen(false);
        toggleBtn.focus();
      }
    });
  }
</script>

<style>
