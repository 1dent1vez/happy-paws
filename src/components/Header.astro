---
import { siteConfig } from '../config/site';
---

<header class="site-header" id="site-header">
  <div class="container header-container">
    <a href="/" class="brand-logo" aria-label="Happy Paws - Inicio">
      <img
        src="/images/logo-mark.png"
        alt=""
        width="52"
        height="23"
        class="logo-img"
        aria-hidden="true"
      />
      <div class="brand-title-wrap">
        <span class="brand-name">Happy Paws</span>
        <span class="location-badge">Foresta Dream Lagoons</span>
      </div>
    </a>

    <!-- Minimal Clean Navigation -->
    <nav class="desktop-nav" aria-label="Navegación principal">
      <ul class="nav-list">
        <li>
          <a href="/#paseos" class="nav-link">Paseos</a>
        </li>
        <li>
          <a href="/#como-funciona" class="nav-link">Cómo Funciona</a>
        </li>
        <li>
          <a href="/#faq" class="nav-link">Preguntas Frecuentes</a>
        </li>
      </ul>
    </nav>

    <!-- Header Direct Action -->
    <div class="header-action">
      <a
        href={siteConfig.instagram.url}
        target="_blank"
        rel="noopener noreferrer"
        class="header-insta-link"
        aria-label="Instagram de Happy Paws (@happypawsmetepec)"
      >
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect>
          <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path>
          <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line>
        </svg>
      </a>

      <!-- Mobile Menu Button -->
      <button
        type="button"
        class="mobile-menu-toggle"
        id="mobile-toggle"
        aria-expanded="false"
        aria-controls="mobile-nav"
        aria-label="Abrir menú"
      >
        <span class="hamburger-bar"></span>
        <span class="hamburger-bar"></span>
        <span class="hamburger-bar"></span>
      </button>
    </div>
  </div>

  <!-- Mobile Clean Drawer -->
  <!-- `inert` mientras está cerrado: sin él los enlaces siguen siendo focusables
       por teclado aunque aria-hidden="true" y max-height:0 los oculten, así que
       un lector de pantalla y el tabulador llegan a contenido "invisible".
       El atributo se mantiene sincronizado desde el script de abajo. -->
  <div class="mobile-nav-drawer" id="mobile-nav" aria-hidden="true" inert>
    <nav class="mobile-nav-links" aria-label="Navegación móvil">
      <a href="/#paseos" class="mobile-link">Paseos y tarifas</a>
      <a href="/#conocenos" class="mobile-link">Conócenos</a>
      <a href="/#como-funciona" class="mobile-link">Cómo Funciona</a>
      <a href="/#faq" class="mobile-link">Preguntas Frecuentes</a>
      <a
        href={siteConfig.instagram.url}
        target="_blank"
        rel="noopener noreferrer"
        class="mobile-link mobile-insta-link"
      >
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect>
          <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path>
          <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line>
        </svg>
        <span>Instagram (@happypawsmetepec)</span>
      </a>
    </nav>
  </div>
</header>

<script>
  const toggleBtn = document.getElementById('mobile-toggle');
  const mobileNav = document.getElementById('mobile-nav');

  /** `inert` es lo que saca al drawer del orden de tabulación cuando está
   *  cerrado; `aria-hidden` solo lo anuncia. Hay que mantener ambos en sync. */
  const setOpen = (open: boolean) => {
    toggleBtn?.setAttribute('aria-expanded', String(open));
    toggleBtn?.setAttribute('aria-label', open ? 'Cerrar menú' : 'Abrir menú');
    mobileNav?.setAttribute('aria-hidden', String(!open));
    mobileNav?.classList.toggle('is-open', open);
    toggleBtn?.classList.toggle('is-active', open);
    if (open) {
      mobileNav?.removeAttribute('inert');
    } else {
      mobileNav?.setAttribute('inert', '');
    }
  };

  if (toggleBtn && mobileNav) {
    toggleBtn.addEventListener('click', () => {
      const isExpanded = toggleBtn.getAttribute('aria-expanded') === 'true';
      setOpen(!isExpanded);
    });

    // Cerrar al elegir un destino: en una landing de una sola página el
    // drawer abierto tapa el contenido al que se acaba de saltar.
    mobileNav.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', () => {
        setOpen(false);
        const destination = new URL(link.href, window.location.href);
        if (destination.pathname === window.location.pathname && destination.hash) {
          const target = document.getElementById(decodeURIComponent(destination.hash.slice(1)));
          if (target) {
            target.setAttribute('tabindex', '-1');
            target.focus({ preventScroll: true });
          }
        }
      });
    });

    const desktop = window.matchMedia('(min-width: 861px)');
    desktop.addEventListener('change', () => {
      if (desktop.matches) {
        const focusWasInside = mobileNav.contains(document.activeElement);
        setOpen(false);
        if (focusWasInside) document.querySelector<HTMLAnchorElement>('.brand-logo')?.focus();
      }
    });
    document.addEventListener('click', (event) => {
      if (!document.getElementById('site-header')?.contains(event.target as Node)) setOpen(false);
    });

    // Escape cierra el drawer, igual que los popovers del hero.
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && toggleBtn.getAttribute('aria-expanded') === 'true') {
        setOpen(false);
        toggleBtn.focus();
      }
    });
  }
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 90;
    background-color: rgba(255, 255, 255, 0.96);
    backdrop-filter: blur(16px) saturate(180%);
    -webkit-backdrop-filter: blur(16px) saturate(180%);
    border-bottom: 1px solid var(--color-border);
    box-shadow: 0 1px 4px rgba(28, 25, 23, 0.03);
    transition: background-color var(--transition-normal), box-shadow var(--transition-normal);
  }

  .header-container {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: var(--header-height);
  }

  .brand-logo {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    text-decoration: none;
    transition: transform var(--transition-fast);
  }

  .brand-logo:hover {
    transform: translateY(-1px);
  }

  .logo-mark {
    display: flex;
    align-items: center;
    justify-content: center;
  }

  /* El logo oficial es un PNG alargado (perro sobre "PAWS"); se respeta su
     proporcion real (2.22:1) y se limita la altura para no desbordar el header. */
  .logo-img {
    height: 34px;
    width: auto;
    flex-shrink: 0;
    object-fit: contain;
  }

  .brand-title-wrap {
    display: flex;
    flex-direction: column;
  }

  .brand-name {
    font-size: 1.25rem;
    font-weight: 800;
    letter-spacing: -0.02em;
    color: var(--color-text-title);
    line-height: 1.1;
  }

  .location-badge {
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--color-primary-action);
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  .desktop-nav {
    display: block;
  }

  .nav-list {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    list-style: none;
  }

  .nav-link {
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--color-text-muted);
    padding: 6px 14px;
    border-radius: var(--radius-full);
    transition: all var(--transition-fast);
  }

  .nav-link:hover {
    color: var(--color-primary-action);
    background-color: var(--color-primary-light);
  }

  .header-action {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }

  .header-insta-link {
    width: 44px;
    height: 44px;
    min-width: 44px;
    min-height: 44px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    border: 1px solid var(--color-border);
    background: var(--color-surface);
    color: var(--color-text-title);
    transition: all var(--transition-fast);
    text-decoration: none;
  }

  .header-insta-link:hover {
    background-color: var(--color-primary-light);
    color: var(--brand-wine);
    border-color: var(--color-primary-border);
    transform: translateY(-1px);
    box-shadow: var(--shadow-sm);
  }

  .mobile-menu-toggle {
    display: none;
    flex-direction: column;
    justify-content: space-around;
    width: 44px;
    height: 44px;
    min-width: 44px;
    min-height: 44px;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    cursor: pointer;
    padding: 11px 9px;
    transition: background-color var(--transition-fast), border-color var(--transition-fast);
  }

  .mobile-menu-toggle:hover {
    background-color: var(--color-primary-light);
    border-color: var(--color-primary-border);
  }

  .hamburger-bar {
    width: 100%;
    height: 2px;
    background-color: var(--color-text-title);
    border-radius: var(--radius-full);
    transition: all var(--transition-normal);
  }

  .mobile-menu-toggle.is-active .hamburger-bar:nth-child(1) {
    transform: translateY(6px) rotate(45deg);
  }

  .mobile-menu-toggle.is-active .hamburger-bar:nth-child(2) {
    opacity: 0;
  }

  .mobile-menu-toggle.is-active .hamburger-bar:nth-child(3) {
    transform: translateY(-6px) rotate(-45deg);
  }

  .mobile-nav-drawer {
    display: none;
  }

  @media (max-width: 860px) {
    .desktop-nav {
      display: none;
    }

    .mobile-menu-toggle {
      display: flex;
    }

    .mobile-nav-drawer {
      display: block;
      max-height: 0;
      overflow: hidden;
      background: var(--brand-cream);
      backdrop-filter: blur(16px);
      border-bottom: 1px solid var(--color-border);
      box-shadow: var(--shadow-lg);
      transition: max-height var(--transition-normal) ease-in-out;
    }

    .mobile-nav-drawer.is-open {
      max-height: min(480px, calc(100dvh - var(--header-height)));
      overflow-y: auto;
    }

    .mobile-nav-links {
      display: flex;
      flex-direction: column;
      padding: var(--space-5) var(--space-4);
      gap: var(--space-2);
    }

    .mobile-link {
      font-size: 1.05rem;
      font-weight: 600;
      color: var(--color-text);
      padding: 12px 16px;
      min-height: 48px;
      display: flex;
      align-items: center;
      border-radius: var(--radius-md);
      transition: background-color var(--transition-fast), color var(--transition-fast);
    }

    .mobile-link:hover,
    .mobile-link:active {
      background-color: var(--color-primary-light);
      color: var(--color-primary-action);
    }

    .mobile-insta-link {
      display: flex;
      align-items: center;
      gap: 12px;
      border-top: 1px solid var(--color-border-subtle);
      margin-top: var(--space-2);
      padding-top: var(--space-4);
      color: var(--color-text-title);
    }

    .mobile-insta-link svg {
      color: var(--brand-wine);
      flex-shrink: 0;
    }
  }

  @media (max-width: 480px) {
    .brand-name {
      font-size: 1.15rem;
    }

    .location-badge {
      font-size: 0.7rem;
    }

    .logo-img {
      height: 30px;
    }
  }

  .w-full {
    width: 100%;
  }
@media (max-width: 480px) {
    .header-insta-link { display: none; }
    .brand-logo { min-width: 0; gap: 8px; }
    .logo-img { width: 48px; height: auto; }
    .location-badge { font-size: .58rem; letter-spacing: .02em; }
    .header-action { margin-left: 12px; }
    .header-container { height: 68px; }
  }
</style>
