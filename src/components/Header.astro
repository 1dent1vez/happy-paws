---

interface Props {
  currentPath?: string;
}
---

<header class="site-header" id="site-header">
  <div class="container header-container">
    <a href="/" class="brand-logo" aria-label="Happy Paws - Inicio">
      <div class="logo-mark" aria-hidden="true">
        <svg width="26" height="26" viewBox="0 0 32 32" fill="none">
          <rect width="32" height="32" rx="8" fill="#EE5D1A"/>
          <path d="M16 23.5C12.8 23.5 11 21.2 11 18.8C11 16.5 13.2 15.2 16 15.2C18.8 15.2 21 16.5 21 18.8C21 21.2 19.2 23.5 16 23.5Z" fill="#FFFFFF"/>
          <circle cx="9.5" cy="13.2" r="2" fill="#FFFFFF"/>
          <circle cx="13.8" cy="10.5" r="2" fill="#FFFFFF"/>
          <circle cx="18.2" cy="10.5" r="2" fill="#FFFFFF"/>
          <circle cx="22.5" cy="13.2" r="2" fill="#FFFFFF"/>
        </svg>
      </div>
      <div class="brand-title-wrap">
        <span class="brand-name">Happy Paws</span>
        <span class="location-badge">Foresta Dream Lagoons</span>
      </div>
    </a>

    <!-- Minimal Clean Navigation -->
    <nav class="desktop-nav" aria-label="Navegación principal">
      <ul class="nav-list">
        <li>
          <a href="/#beneficios" class="nav-link">Beneficios</a>
        </li>
        <li>
          <a href="/#como-funciona" class="nav-link">Cómo Funciona</a>
        </li>
        <li>
          <a href="/#faq" class="nav-link">Preguntas Frecuentes</a>
        </li>
      </ul>
    </nav>

    <!-- Header Direct Action -->
    <div class="header-action">
      <!-- Mobile Menu Button -->
      <button
        type="button"
        class="mobile-menu-toggle"
        id="mobile-toggle"
        aria-expanded="false"
        aria-controls="mobile-nav"
        aria-label="Abrir menú"
      >
        <span class="hamburger-bar"></span>
        <span class="hamburger-bar"></span>
        <span class="hamburger-bar"></span>
      </button>
    </div>
  </div>

  <!-- Mobile Clean Drawer -->
  <div class="mobile-nav-drawer" id="mobile-nav" aria-hidden="true">
    <nav class="mobile-nav-links" aria-label="Navegación móvil">
      <a href="/#beneficios" class="mobile-link">Beneficios para tu Mascota</a>
      <a href="/#como-funciona" class="mobile-link">Cómo Funciona</a>
      <a href="/#faq" class="mobile-link">Preguntas Frecuentes</a>

    </nav>
  </div>
</header>

<script>
  const toggleBtn = document.getElementById('mobile-toggle');
  const mobileNav = document.getElementById('mobile-nav');

  if (toggleBtn && mobileNav) {
    toggleBtn.addEventListener('click', () => {
      const isExpanded = toggleBtn.getAttribute('aria-expanded') === 'true';
      toggleBtn.setAttribute('aria-expanded', String(!isExpanded));
      mobileNav.setAttribute('aria-hidden', String(isExpanded));
      mobileNav.classList.toggle('is-open', !isExpanded);
      toggleBtn.classList.toggle('is-active', !isExpanded);
    });

    mobileNav.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', () => {
        toggleBtn.setAttribute('aria-expanded', 'false');
        mobileNav.setAttribute('aria-hidden', 'true');
        mobileNav.classList.remove('is-open');
        toggleBtn.classList.remove('is-active');
      });
    });
  }
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 90;
    background-color: rgba(250, 247, 242, 0.94);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    border-bottom: 1px solid var(--color-border);
  }

  .header-container {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: var(--header-height);
  }

  .brand-logo {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    text-decoration: none;
  }

  .logo-mark {
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .brand-title-wrap {
    display: flex;
    flex-direction: column;
  }

  .brand-name {
    font-size: 1.25rem;
    font-weight: 800;
    letter-spacing: -0.02em;
    color: var(--color-text-title);
    line-height: 1.1;
  }

  .location-badge {
    font-size: 0.72rem;
    font-weight: 700;
    color: var(--color-primary);
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .desktop-nav {
    display: block;
  }

  .nav-list {
    display: flex;
    align-items: center;
    gap: var(--space-8);
    list-style: none;
  }

  .nav-link {
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--color-text-muted);
    transition: color var(--transition-fast);
  }

  .nav-link:hover {
    color: var(--color-primary);
  }

  .header-action {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }

  .mobile-menu-toggle {
    display: none;
    flex-direction: column;
    justify-content: space-around;
    width: 38px;
    height: 38px;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    cursor: pointer;
    padding: 8px;
  }

  .hamburger-bar {
    width: 100%;
    height: 2px;
    background-color: var(--color-text-title);
    border-radius: var(--radius-full);
    transition: all var(--transition-normal);
  }

  .mobile-menu-toggle.is-active .hamburger-bar:nth-child(1) {
    transform: translateY(6px) rotate(45deg);
  }

  .mobile-menu-toggle.is-active .hamburger-bar:nth-child(2) {
    opacity: 0;
  }

  .mobile-menu-toggle.is-active .hamburger-bar:nth-child(3) {
    transform: translateY(-6px) rotate(-45deg);
  }

  .mobile-nav-drawer {
    display: none;
  }

  @media (max-width: 860px) {
    .desktop-nav {
      display: none;
    }

    .mobile-menu-toggle {
      display: flex;
    }

    .mobile-nav-drawer {
      display: block;
      max-height: 0;
      overflow: hidden;
      background: var(--color-surface);
      border-bottom: 1px solid var(--color-border);
      transition: max-height var(--transition-normal) ease-in-out;
    }

    .mobile-nav-drawer.is-open {
      max-height: 340px;
    }

    .mobile-nav-links {
      display: flex;
      flex-direction: column;
      padding: var(--space-6) var(--space-4);
      gap: var(--space-2);
    }

    .mobile-link {
      font-size: 1rem;
      font-weight: 600;
      color: var(--color-text);
      padding: var(--space-3) var(--space-4);
      border-radius: var(--radius-md);
    }

    .mobile-link:hover {
      background-color: var(--color-primary-light);
      color: var(--color-primary);
    }

    .mobile-cta-box {
      margin-top: var(--space-3);
      padding-top: var(--space-4);
      border-top: 1px solid var(--color-border);
      display: flex;
      flex-direction: column;
      gap: var(--space-2);
    }

    .mobile-location-tag {
      font-size: 0.775rem;
      color: var(--color-text-subtle);
      text-align: center;
    }
  }

  .w-full {
    width: 100%;
  }
</style>
