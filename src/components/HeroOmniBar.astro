---
import { siteConfig } from '../config/site';

interface Props {
  className?: string;
}

const { className = '' } = Astro.props;
const phoneRaw = siteConfig.whatsapp.phoneRaw.replace(/\D/g, '');

// Mensaje genérico para el href inicial. El script lo reescribe con la
// configuración elegida, pero sin JS este enlace ya lleva a WhatsApp con un
// mensaje útil en lugar de no hacer nada.
const baseWaUrl =
  'https://wa.me/' +
  phoneRaw +
  '?text=' +
  encodeURIComponent(siteConfig.whatsapp.messages.main);
---

<div class={`hero-omni-wrapper ${className}`} id="hero-omni-wrapper">
  <!-- No es role="search": esto no busca nada, es un configurador de cita.
       Anunciarlo como buscador confunde a quien navega con lector de pantalla. -->
  <div class="hero-omni-bar" role="group" aria-label="Configurar tu paseo en Foresta Dream Lagoons">

    <!-- 1. SERVICIO -->
    <div class="omni-segment-wrap" id="seg-wrap-servicio">
      <button type="button" class="omni-segment" id="btn-servicio"
        aria-expanded="false" aria-haspopup="listbox" aria-controls="pop-servicio">
        <span class="omni-label">Servicio</span>
        <span class="omni-value omni-ph" id="val-servicio">Elegir un servicio</span>
      </button>

      <div class="omni-pop" id="pop-servicio" role="listbox" aria-label="Elegir modalidad de paseo" aria-hidden="true" inert>
        <div class="pop-header">
          <span class="pop-title">Elige la modalidad</span>
        </div>
        <div class="svc-list">

          <button type="button" class="svc-btn" role="option" aria-selected="false" data-value="Individual">
            <div class="svc-icon">
              <svg width="24" height="24" viewBox="0 0 576 512" fill="currentColor" aria-hidden="true">
                <path d="M309.6 158.5L332.7 19.8C334.6 8.4 344.5 0 356.1 0c7.5 0 14.5 3.5 19 9.5L392 32l52.1 0c12.7 0 24.9 5.1 33.9 14.1L496 64l56 0c13.3 0 24 10.7 24 24l0 24c0 44.2-35.8 80-80 80l-32 0-16 0-21.3 0-5.1 30.5-112-64zM416 256.1L416 480c0 17.7-14.3 32-32 32l-32 0c-17.7 0-32-14.3-32-32l0-115.2c-24 12.3-51.2 19.2-80 19.2s-56-6.9-80-19.2L160 480c0 17.7-14.3 32-32 32l-32 0c-17.7 0-32-14.3-32-32l0-230.2c-28.8-10.9-51.4-35.3-59.2-66.5L1 167.8c-4.3-17.1 6.1-34.5 23.3-38.8s34.5 6.1 38.8 23.3l3.9 15.5C70.5 182 83.3 192 98 192l30 0 16 0 159.8 0L416 256.1zM464 80a16 16 0 1 0 -32 0 16 16 0 1 0 32 0z"/>
              </svg>
            </div>
            <div class="svc-text">
              <span class="svc-name">Paseo Individual</span>
              <span class="svc-desc">Atención exclusiva 1 a 1, a su ritmo</span>
            </div>
            <span class="svc-check" aria-hidden="true">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
            </span>
          </button>

          <button type="button" class="svc-btn" role="option" aria-selected="false" data-value="Grupal">
            <div class="svc-icon">
              <svg width="22" height="22" viewBox="0 0 512 512" fill="currentColor" aria-hidden="true">
                <path d="M226.5 92.9c14.3 42.9-.3 86.2-32.6 96.8s-70.1-15.6-84.4-58.5s.3-86.2 32.6-96.8s70.1 15.6 84.4 58.5zM100.4 198.6c18.9 32.4 14.3 70.1-10.2 84.1s-59.7-.9-78.5-33.3S-2.7 179.3 21.8 165.3s59.7 .9 78.5 33.3zM69.2 401.2C121.6 259.9 214.7 224 256 224s134.4 35.9 186.8 177.2c3.6 9.7 5.2 20.1 5.2 30.5l0 1.6c0 25.8-20.9 46.7-46.7 46.7c-11.5 0-22.9-1.4-34-4.2l-88-22c-15.3-3.8-31.3-3.8-46.6 0l-88 22c-11.1 2.8-22.5 4.2-34 4.2C84.9 480 64 459.1 64 433.3l0-1.6c0-10.4 1.6-20.8 5.2-30.5zM421.8 282.7c-24.5-14-29.1-51.7-10.2-84.1s54-47.3 78.5-33.3s29.1 51.7 10.2 84.1s-54 47.3-78.5 33.3zM310.1 189.7c-32.3-10.6-46.9-53.9-32.6-96.8s52.1-69.1 84.4-58.5s46.9 53.9 32.6 96.8s-52.1 69.1-84.4 58.5z"/>
              </svg>
            </div>
            <div class="svc-text">
              <span class="svc-name">Paseo Grupal Controlado</span>
              <span class="svc-desc">Máx. 3-4 perros con temperamentos compatibles</span>
            </div>
            <span class="svc-check" aria-hidden="true">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
            </span>
          </button>

        </div>
      </div>
    </div>

    <div class="omni-divider" aria-hidden="true"></div>

    <!-- 2. FECHA -->
    <div class="omni-segment-wrap" id="seg-wrap-fecha">
      <button type="button" class="omni-segment" id="btn-fecha"
        aria-expanded="false" aria-haspopup="dialog" aria-controls="pop-fecha">
        <span class="omni-label">Fechas</span>
        <span class="omni-value omni-ph" id="val-fecha">¿Cuándo quieres el paseo?</span>
      </button>

      <div class="omni-pop pop-calendar" id="pop-fecha" role="dialog" aria-label="Seleccionar fecha y hora" aria-hidden="true" inert>
        <div class="pop-header">
          <span class="pop-title">Selecciona una fecha</span>
        </div>
        <div class="cal-nav">
          <button type="button" class="cal-nav-btn" id="cal-prev" aria-label="Mes anterior">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"/></svg>
          </button>
          <span class="cal-month" id="cal-month"></span>
          <button type="button" class="cal-nav-btn" id="cal-next" aria-label="Mes siguiente">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg>
          </button>
        </div>
        <div class="cal-wd" aria-hidden="true">
          <span>Lu</span><span>Ma</span><span>Mi</span><span>Ju</span><span>Vi</span><span>Sá</span><span>Do</span>
        </div>
        <div class="cal-grid" id="cal-grid" role="grid"></div>

        <!-- Franja horaria: aparece al elegir un día. Limitada a 7:00-19:00
             porque es la franja real de operación. -->
        <div class="hours-wrap" id="hours-wrap" hidden>
          <div class="hours-head">
            <span class="hours-label" id="hours-label"></span>
          </div>
          <div class="hours-list" id="hours-list" role="group" aria-label="Elegir hora de llegada"></div>
          <p class="hours-empty" id="hours-empty" role="status" hidden></p>
          <p class="hours-hint">
            La hora se confirma por WhatsApp según disponibilidad del paseador.
          </p>
          <div class="hours-footer">
            <button type="button" class="btn-done" id="btn-hours-done">Listo</button>
          </div>
        </div>
      </div>
    </div>

    <div class="omni-divider" aria-hidden="true"></div>

    <!-- 3. MASCOTAS -->
    <div class="omni-segment-wrap" id="seg-wrap-mascotas">
      <button type="button" class="omni-segment" id="btn-mascotas"
        aria-expanded="false" aria-haspopup="dialog" aria-controls="pop-mascotas">
        <span class="omni-label">Mascotas</span>
        <span class="omni-value omni-ph" id="val-mascotas">Añade tus mascotas</span>
      </button>

      <div class="omni-pop pop-counter" id="pop-mascotas" role="dialog" aria-label="Número de mascotas" aria-hidden="true" inert>
        <div class="ctr-row">
          <div class="ctr-info">
            <span class="ctr-label">Perros en casa</span>
            <span class="ctr-sub">¿Cuántos perros pasearán?</span>
          </div>
          <div class="ctr-ctrl">
            <button type="button" class="ctr-btn" id="btn-minus" aria-label="Restar perro" disabled>
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><line x1="5" y1="12" x2="19" y2="12"/></svg>
            </button>
            <span class="ctr-num" id="ctr-num" aria-live="polite">1</span>
            <button type="button" class="ctr-btn" id="btn-plus" aria-label="Agregar perro">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
            </button>
          </div>
        </div>
        <div class="ctr-footer">
          <button type="button" class="btn-done" id="btn-done">Listo</button>
        </div>
      </div>
    </div>

    <!-- CTA WhatsApp -->
    <!-- Es un <a> con href real, no un <button>: así funciona aunque el JS no
         cargue o el navegador bloquee window.open. El href apunta al mensaje
         genérico; si el visitante configura servicio/fecha/mascotas, el script
         lo reescribe con esos datos antes de navegar. -->
    <div class="omni-cta-wrap">
      <a
        href={baseWaUrl}
        id="btn-cta"
        class="omni-cta"
        target="_blank"
        rel="noopener noreferrer"
        data-hp-context="omnibar"
        aria-label="Consultar disponibilidad por WhatsApp"
      >
        <svg width="19" height="19" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.45 1.32 4.95L2.05 22l7.25-1.38a9.87 9.87 0 0 0 4.74 1.21c5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.88 9.88 0 0 0 12.04 2zm0 1.67c2.2 0 4.26.86 5.82 2.42a8.22 8.22 0 0 1 2.42 5.82c0 4.54-3.7 8.24-8.24 8.24-1.48 0-2.93-.4-4.19-1.15l-.3-.18-3.12.82.83-3.04-.2-.32a8.21 8.21 0 0 1-1.25-4.4c0-4.54 3.7-8.21 8.23-8.21zM9.53 7.34l-.08-.01c-.17 0-.45.06-.69.32-.24.26-.89.87-.89 2.12s.91 2.46 1.04 2.63c.13.17 1.76 2.68 4.25 3.75.59.26 1.05.41 1.41.53.6.19 1.14.16 1.57.1.48-.07 1.48-.61 1.69-1.19.21-.59.21-1.09.14-1.2-.07-.11-.25-.18-.52-.31-.27-.13-1.59-.78-1.84-.87-.24-.09-.41-.14-.59.14-.17.27-.67.86-.82 1.04-.15.17-.3.19-.57.06-.27-.13-1.14-.42-2.17-1.34-.8-.72-1.34-1.61-1.5-1.88-.15-.27-.02-.42.11-.55.12-.11.26-.3.4-.46.14-.17.18-.28.27-.46.09-.17.05-.32-.02-.46-.07-.13-.59-1.42-.81-1.94-.22-.51-.44-.44-.6-.44z"/>
        </svg>
        <span>Consultar</span>
      </a>
    </div>

  </div>
</div>

<script is:inline define:vars={{ phoneRaw }}>
(function() {
  // Wait for DOM
  function init() {
    // Ojo: este array debe tener los 12 meses en orden. Sin 'Septiembre'
    // todos los meses a partir de ahí se mostraban con el nombre siguiente
    // (octubre salía como "Noviembre"), y el error se propagaba a la etiqueta
    // accesible de cada día, al resumen de la fecha y a la franja horaria.
    var MONTHS = ['Enero','Febrero','Marzo','Abril','Mayo','Junio','Julio','Agosto','Septiembre','Octubre','Noviembre','Diciembre'];

    // Franja operativa. Debe coincidir con siteConfig.schedule y con el
    // JSON-LD: el servicio corre 7:00-19:00, así que ninguna cita fuera de
    // ese rango es realizable y el lead llegaría pidiendo un hueco imposible.
    //
    // LAST_ARRIVAL es la última hora de LLEGADA ofrecida. Un paseo dura 45-60
    // minutos y el servicio cierra a las 19:00, así que una llegada a las
    // 19:00 implicaría pasear después del cierre: se ofrece hasta las 18:00,
    // que es lo que cabe dentro de la franja declarada.
    var OPEN_HOUR = 7;
    var LAST_ARRIVAL = 18;

    // ── State ──────────────────────────────────────────
    var selService = null;
    var selDate    = null; // Date object
    var selHour    = null; // number (hora local 0-23)
    var petCount   = 1;
    var calYear, calMonth;

    var today = new Date();
    today.setHours(0,0,0,0);
    calYear  = today.getFullYear();
    calMonth = today.getMonth();

    // ── Elements ────────────────────────────────────────
    var wrapper     = document.getElementById('hero-omni-wrapper');
    var btnServicio = document.getElementById('btn-servicio');
    var popServicio = document.getElementById('pop-servicio');
    var valServicio = document.getElementById('val-servicio');

    var btnFecha    = document.getElementById('btn-fecha');
    var popFecha    = document.getElementById('pop-fecha');
    var valFecha    = document.getElementById('val-fecha');

    var btnMascota  = document.getElementById('btn-mascotas');
    var popMascota  = document.getElementById('pop-mascotas');
    var valMascota  = document.getElementById('val-mascotas');
    var ctrNum      = document.getElementById('ctr-num');
    var btnMinus    = document.getElementById('btn-minus');
    var btnPlus     = document.getElementById('btn-plus');
    var btnDone     = document.getElementById('btn-done');

    var btnCta      = document.getElementById('btn-cta');

    if (!wrapper) return; // Component not found

    // ── Popovers ────────────────────────────────────────
    var allPops  = [popServicio, popFecha, popMascota];
    var allBtns  = [btnServicio, btnFecha,  btnMascota];
    var allWraps = [
      document.getElementById('seg-wrap-servicio'),
      document.getElementById('seg-wrap-fecha'),
      document.getElementById('seg-wrap-mascotas'),
    ];
    // Trigger dueño del popover abierto, para devolverle el foco al cerrar.
    var activeTrigger = null;

    function closeAll(restoreFocus) {
      allPops.forEach(function(p) {
        if (p) {
          p.classList.remove('is-open');
          p.setAttribute('aria-hidden','true');
          // `inert` saca los controles del panel del orden de tabulación.
          // Sin él, `visibility: hidden` los oculta visualmente pero el
          // tabulador sigue entrando a botones que no se ven.
          p.setAttribute('inert','');
        }
      });
      allBtns.forEach(function(b) {
        if (b) b.setAttribute('aria-expanded','false');
      });
      allWraps.forEach(function(w) {
        if (w) w.classList.remove('is-active');
      });
      // Al cerrar por Escape el foco debe volver al botón que abrió el panel;
      // si no, el tabulador salta al inicio del documento.
      if (restoreFocus && activeTrigger && typeof activeTrigger.focus === 'function') {
        activeTrigger.focus();
      }
      activeTrigger = null;
    }

    function open(pop, btn, wrap) {
      closeAll(false);
      pop.classList.add('is-open');
      pop.setAttribute('aria-hidden','false');
      pop.removeAttribute('inert');
      btn.setAttribute('aria-expanded','true');
      if (wrap) wrap.classList.add('is-active');
      activeTrigger = btn;

      // Mover el foco al primer control del panel. Sin esto un usuario de
      // teclado abre el popover y sigue tabulando por el resto de la página,
      // fuera del panel que acaba de abrir.
      var first = pop.querySelector('button:not([disabled]), [tabindex]:not([tabindex="-1"])');
      if (first && typeof first.focus === 'function') first.focus();
    }

    function toggle(pop, btn, wrap) {
      if (pop.classList.contains('is-open')) { closeAll(true); }
      else { open(pop, btn, wrap); }
    }

    // Segment clicks
    btnServicio && btnServicio.addEventListener('click', function(e) {
      e.stopPropagation();
      toggle(popServicio, btnServicio, document.getElementById('seg-wrap-servicio'));
    });

    btnFecha && btnFecha.addEventListener('click', function(e) {
      e.stopPropagation();
      renderCal();
      toggle(popFecha, btnFecha, document.getElementById('seg-wrap-fecha'));
    });

    btnMascota && btnMascota.addEventListener('click', function(e) {
      e.stopPropagation();
      toggle(popMascota, btnMascota, document.getElementById('seg-wrap-mascotas'));
    });

    // Close on outside click / Escape
    document.addEventListener('click', function(e) {
      if (!wrapper.contains(e.target)) closeAll(false);
    });
    document.addEventListener('keydown', function(e) {
      if (e.key === 'Escape') closeAll(true);
    });

    // ── Servicio ────────────────────────────────────────
    var svcBtns = popServicio ? popServicio.querySelectorAll('.svc-btn') : [];
    svcBtns.forEach(function(btn) {
      btn.addEventListener('click', function(e) {
        e.stopPropagation();
        svcBtns.forEach(function(b) { b.classList.remove('is-sel'); b.setAttribute('aria-selected','false'); });
        btn.classList.add('is-sel');
        btn.setAttribute('aria-selected','true');

        selService = btn.getAttribute('data-value');
        if (valServicio) {
          valServicio.textContent = selService === 'Individual' ? 'Paseo Individual' : 'Paseo Grupal';
          valServicio.classList.remove('omni-ph');
        }
        syncCta();
        setTimeout(function() { closeAll(true); }, 150);
      });

      // Un role="listbox" se espera navegable con flechas; sin esto sus
      // opciones solo son alcanzables con Tab, una por una.
      btn.addEventListener('keydown', function(e) {
        var i = Array.prototype.indexOf.call(svcBtns, btn);
        var next = null;
        if (e.key === 'ArrowDown') next = svcBtns[(i + 1) % svcBtns.length];
        else if (e.key === 'ArrowUp') next = svcBtns[(i - 1 + svcBtns.length) % svcBtns.length];
        else if (e.key === 'Home') next = svcBtns[0];
        else if (e.key === 'End') next = svcBtns[svcBtns.length - 1];
        if (next) {
          e.preventDefault();
          e.stopPropagation();
          next.focus();
        }
      });
    });

    // ── Calendario ──────────────────────────────────────
    function renderCal() {
      var monthEl = document.getElementById('cal-month');
      var grid    = document.getElementById('cal-grid');
      var prevBtn = document.getElementById('cal-prev');
      if (!monthEl || !grid) return;

      monthEl.textContent = MONTHS[calMonth] + ' ' + calYear;

      // Disable prev if already at current month
      if (prevBtn) {
        var atMin = (calYear < today.getFullYear()) ||
                    (calYear === today.getFullYear() && calMonth <= today.getMonth());
        prevBtn.disabled = atMin;
        prevBtn.style.opacity = atMin ? '0.3' : '1';
        prevBtn.style.cursor  = atMin ? 'not-allowed' : 'pointer';
      }

      grid.innerHTML = '';

      // Monday-first offset
      var firstDow = new Date(calYear, calMonth, 1).getDay();
      var offset   = (firstDow + 6) % 7; // Mon=0 … Sun=6
      var days     = new Date(calYear, calMonth + 1, 0).getDate();

      // Empty cells
      for (var i = 0; i < offset; i++) {
        var empty = document.createElement('span');
        empty.className = 'cal-cell empty';
        grid.appendChild(empty);
      }

      // Day cells
      for (var d = 1; d <= days; d++) {
        (function(day) {
          var dayDate = new Date(calYear, calMonth, day);
          var btn     = document.createElement('button');
          btn.type      = 'button';
          btn.className = 'cal-cell';
          btn.textContent = String(day);

          var isPast     = dayDate < today;
          var isToday    = dayDate.getTime() === today.getTime();
          var isSelected = selDate && dayDate.getTime() === selDate.getTime();
          // El servicio no opera en domingo: ofrecerlo dejaba "agendar" un
          // día en que nadie va a pasear al perro.
          var isSunday   = dayDate.getDay() === 0;
          // Etiqueta accesible: los números sueltos de una rejilla se leen
          // como "15", no como "15 de noviembre".
          btn.setAttribute('aria-label',
            day + ' de ' + MONTHS[calMonth] + ' de ' + calYear +
            (isSunday ? ' (cerrado los domingos)' : ''));

          if (isPast || isSunday) {
            btn.disabled = true;
            btn.classList.add(isSunday ? 'closed' : 'past');
          } else if (isSelected) {
            btn.classList.add('sel');
          } else if (isToday) {
            btn.classList.add('tod');
          }

          if (!isPast && !isSunday) {
            btn.addEventListener('click', function(e) {
              e.stopPropagation();
              selDate = dayDate;
              var formatted = day + ' ' + MONTHS[calMonth] + (selHour != null ? ' · ' + pad(selHour) + ':00' : ', ' + calYear);
              if (valFecha) {
                valFecha.textContent = formatted;
                valFecha.classList.remove('omni-ph');
              }
              // El popover NO se cierra aquí: tras elegir el día hay que
              // elegir la hora, así que se queda abierto. Antes se cerraba a
              // los 150ms y la franja horaria se renderizaba dentro de un
              // panel ya invisible, con lo que el usuario nunca llegaba a
              // indicar la hora.
              renderCal();
              renderHours();
              syncCta();
            });
          }

          grid.appendChild(btn);
        })(d);
      }
    }

    // ── Franja horaria ───────────────────────────────────
    // Tras elegir el día se ofrece la hora dentro de 7:00-19:00. Antes el
    // hero capturaba solo la fecha, así que un lead podía "agendar" a las
    // 23:00 en un servicio que cierra a las 19:00.
    function renderHours() {
      var wrap  = document.getElementById('hours-wrap');
      var list  = document.getElementById('hours-list');
      var label = document.getElementById('hours-label');
      var empty = document.getElementById('hours-empty');
      if (!wrap || !list) return;

      if (!selDate) { wrap.hidden = true; return; }

      var now = new Date();
      var isToday = selDate.getTime() === today.getTime();
      if (label) {
        label.textContent = selDate.getDate() + ' de ' + MONTHS[selDate.getMonth()] +
          ' · llegadas de ' + pad(OPEN_HOUR) + ':00 a ' + pad(LAST_ARRIVAL) + ':00';
      }

      list.innerHTML = '';
      var disponibles = 0;
      for (var h = OPEN_HOUR; h <= LAST_ARRIVAL; h++) {
        (function(hour) {
          // El mismo día ya no admite horas que hayan pasado.
          var past = isToday && hour <= now.getHours();
          var b = document.createElement('button');
          b.type = 'button';
          b.className = 'hour-cell' + (selHour === hour ? ' sel' : '');
          b.textContent = pad(hour) + ':00';
          b.disabled = past;
          if (past) b.classList.add('past');
          b.setAttribute('aria-pressed', String(selHour === hour));
          if (!past) disponibles++;
          if (!past) {
            b.addEventListener('click', function(e) {
              e.stopPropagation();
              selHour = hour;
              if (valFecha && selDate) {
                valFecha.textContent = selDate.getDate() + ' ' + MONTHS[selDate.getMonth()] + ' · ' + pad(hour) + ':00';
              }
              renderHours();
              syncCta();
            });
          }
          list.appendChild(b);
        })(h);
      }

      // Si es tarde y ya cerró hoy, el panel no puede quedarse en blanco sin
      // explicación: se indica y se sugiere el día siguiente. Se salta el
      // domingo, que está cerrado: sugerirlo dejaría al usuario eligiendo un
      // día en que nadie va a pasear al perro.
      if (empty) {
        if (disponibles === 0) {
          empty.hidden = false;
          var manana = new Date(today.getTime() + 86400000);
          while (manana.getDay() === 0) {
            manana = new Date(manana.getTime() + 86400000);
          }
          empty.textContent = 'Hoy ya no quedan llegadas dentro de la franja de ' +
            pad(OPEN_HOUR) + ':00 a ' + pad(LAST_ARRIVAL) + ':00. Puedes elegir el ' +
            manana.getDate() + ' de ' + MONTHS[manana.getMonth()] + ' o escribirnos por WhatsApp.';
        } else {
          empty.hidden = true;
          empty.textContent = '';
        }
      }
      wrap.hidden = false;
    }

    function pad(n) { return n < 10 ? '0' + n : String(n); }

    document.getElementById('cal-prev') && document.getElementById('cal-prev').addEventListener('click', function(e) {
      e.stopPropagation();
      calMonth--;
      if (calMonth < 0) { calMonth = 11; calYear--; }
      renderCal();
    });

    document.getElementById('cal-next') && document.getElementById('cal-next').addEventListener('click', function(e) {
      e.stopPropagation();
      calMonth++;
      if (calMonth > 11) { calMonth = 0; calYear++; }
      renderCal();
    });

    // ── Mascotas counter ─────────────────────────────────
    function updateCount(n) {
      petCount = Math.min(5, Math.max(1, n));
      if (ctrNum)   ctrNum.textContent = String(petCount);
      if (btnMinus) btnMinus.disabled  = petCount <= 1;
      if (btnPlus)  btnPlus.disabled   = petCount >= 5;
      if (valMascota) {
        valMascota.textContent = petCount === 1 ? '1 perro' : petCount + ' perros';
        valMascota.classList.remove('omni-ph');
      }
      syncCta();
    }

    btnMinus && btnMinus.addEventListener('click', function(e) { e.stopPropagation(); updateCount(petCount - 1); });
    btnPlus  && btnPlus.addEventListener('click',  function(e) { e.stopPropagation(); updateCount(petCount + 1); });
    btnDone  && btnDone.addEventListener('click',  function(e) { e.stopPropagation(); closeAll(true); });

    // Cierra el panel de fecha/hora y devuelve el foco a su trigger.
    var btnHoursDone = document.getElementById('btn-hours-done');
    btnHoursDone && btnHoursDone.addEventListener('click', function(e) {
      e.stopPropagation();
      closeAll(true);
    });

    // ── CTA WhatsApp ─────────────────────────────────────
    // El href ya viene servido con el mensaje genérico, así que este handler
    // solo lo enriquece con lo que el visitante configuró y deja que el
    // navegador navegue con normalidad. Nada de window.open: eso lo bloquean
    // los bloqueadores de popups y no funciona sin JS.
    //
    // El evento de conversión NO se emite aquí: initConversionTracking
    // (BaseLayout) ya escucha todos los clics a wa.me por delegación. Emitir
    // también desde aquí duplicaba cada conversión en el dataLayer. Lo que se
    // hace es publicar la configuración elegida en data-hp-detail en el
    // momento de elegirla (syncCta), para que el listener delegado la lea.

    function syncCta() {
      if (!btnCta) return;
      var srvTxt  = selService  ? 'Paseo ' + selService : 'No especificado';
      var dateTxt = selDate
        ? selDate.getDate() + ' de ' + MONTHS[selDate.getMonth()] + ' de ' + selDate.getFullYear()
        : 'No especificada';
      var hourTxt = selHour != null ? pad(selHour) + ':00' : 'Por definir';
      var petTxt  = petCount === 1 ? '1 perro' : petCount + ' perros';
      var detail = [srvTxt, dateTxt + ' ' + hourTxt, petTxt].join(' | ');

      btnCta.setAttribute('data-hp-detail', detail);

      // Se reescribe el href solo si hay algo configurado; si no, se deja el
      // genérico que ya traía el enlace.
      var configurado = selService || selDate || selHour != null || petCount !== 1;
      if (configurado) {
        var msg = 'Hola, quiero consultar disponibilidad en Foresta Dream Lagoons.\n' +
          '• Modalidad: ' + srvTxt + '\n' +
          '• Fecha tentativa: ' + dateTxt + '\n' +
          '• Hora tentativa: ' + hourTxt + '\n' +
          '• Mascotas: ' + petTxt;
        btnCta.setAttribute('href', 'https://wa.me/' + phoneRaw + '?text=' + encodeURIComponent(msg));
      }
    }
  }

  // Run after DOM is ready
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', init);
  } else {
    init();
  }
})();
</script>

