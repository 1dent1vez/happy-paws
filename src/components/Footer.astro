---
import { siteConfig } from '../config/site';
import WhatsAppButton from './WhatsAppButton.astro';
---

<footer class="site-footer">
  <div class="container">
    <div class="footer-grid">
      <!-- Col 1: Brand Info -->
      <div class="footer-col brand-col">
        <div class="footer-logo">
          <img
            src="/images/logo-mark.png"
            alt=""
            width="44"
            height="20"
            class="logo-img"
            aria-hidden="true"
          />
          <span class="footer-brand-name">Happy Paws</span>
        </div>
        <p class="footer-bio">
          Paseos conscientes, seguros y personalizados para perros. Exclusivo para la comunidad residencial de Foresta Dream Lagoons.
        </p>
        <div class="footer-cta-wrap">
          <WhatsAppButton
            context="general"
            text="Escríbenos por WhatsApp"
            size="sm"
            variant="whatsapp"
            id="footer-cta"
          />
        </div>
      </div>

      <!-- Col 2: Navigation Links -->
      <div class="footer-col">
        <h4 class="footer-heading">Navegación</h4>
        <ul class="footer-links">
          <li><a href="/">Inicio</a></li>
          <li><a href="/#beneficios">Beneficios para la Mascota</a></li>
          <li><a href="/#como-funciona">Cómo Funciona</a></li>
          <li><a href="/#faq">Preguntas Frecuentes</a></li>
          <li><a href="/paseos/" class="sublanding-link">Detalles de Modalidades</a></li>
        </ul>
      </div>

      <!-- Col 3: Exclusive Area -->
      <div class="footer-col">
        <h4 class="footer-heading">Zona Exclusiva</h4>
        <p class="footer-meta-text">
          {siteConfig.coverage.description}
        </p>
        <div class="exclusive-badge">
          <span>{siteConfig.coverage.community}</span>
        </div>
        <p class="footer-zone-note">
          Rutas dentro del fraccionamiento y sus áreas verdes para máxima seguridad y tranquilidad.
        </p>
      </div>

      <!-- Col 4: Schedule & Attention -->
      <div class="footer-col">
        <h4 class="footer-heading">Horarios y Atención</h4>
        <div class="schedule-card">
          <p class="schedule-days"><strong>Días:</strong> {siteConfig.schedule.days}</p>
          <p class="schedule-hours"><strong>Horario:</strong> {siteConfig.schedule.hours}</p>
          <p class="schedule-note">{siteConfig.schedule.note}</p>
        </div>
        <div class="contact-card">
          <p class="contact-label">Canal directo:</p>
          <p class="contact-val">WhatsApp: {siteConfig.whatsapp.phoneFormatted}</p>
        </div>
      </div>
    </div>

    <!-- Transparency Disclaimer (No emojis) -->
    <div class="footer-transparency">
      <div class="transparency-badge">Compromiso de Honestidad y Cuidado Responsable</div>
      <p>
        Happy Paws es un servicio de paseo, recreación y bienestar canino al aire libre en Foresta Dream Lagoons. No ofrecemos diagnóstico veterinario ni modificación conductual clínica. Cada salida se realiza respetando las indicaciones de su familia y comunicando con total transparencia lo ocurrido.
      </p>
    </div>

    <!-- Bottom Bar -->
    <div class="footer-bottom">
      <p class="copyright">
        © {new Date().getFullYear()} Happy Paws. Todos los derechos reservados.
      </p>
      <div class="legal-links">
        <a href="/aviso-de-privacidad/">Aviso de Privacidad</a>
        <span class="sep">•</span>
        <a href="/terminos-del-servicio/">Términos del Servicio</a>
      </div>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background-color: #211D1A;
    color: #E6DFD7;
    padding-top: var(--space-16);
    padding-bottom: var(--space-8);
    margin-top: auto;
    border-top: 1px solid #36302B;
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 1.4fr 1fr 1.3fr 1.3fr;
    gap: var(--space-10);
    margin-bottom: var(--space-12);
  }

  .brand-col {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .footer-logo {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }

  .logo-img {
    height: 30px;
    width: auto;
    flex-shrink: 0;
    object-fit: contain;
  }

  .footer-brand-name {
    font-size: 1.35rem;
    font-weight: 800;
    color: #FFFFFF;
    letter-spacing: -0.02em;
  }

  .site-footer p {
    color: #D6CBC0;
  }

  .footer-bio {
    font-size: 0.95rem;
    line-height: 1.6;
    color: #D6CBC0;
  }

  .footer-heading {
    font-size: 0.95rem;
    font-weight: 700;
    color: #FFFFFF;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: var(--space-4);
  }

  .footer-links {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .footer-links a {
    color: #C4B9AD;
    font-size: 0.95rem;
    transition: color var(--transition-fast);
  }

  .footer-links a:hover {
    color: #FDBA74;
  }

  .sublanding-link {
    font-size: 0.85rem !important;
    opacity: 0.85;
  }

  .footer-meta-text {
    font-size: 0.9rem;
    color: #D6CBC0;
    margin-bottom: var(--space-3);
  }

  .exclusive-badge {
    display: inline-block;
    background-color: #2E2925;
    color: #FDBA74;
    border: 1px solid #443B33;
    padding: 6px 14px;
    border-radius: var(--radius-md);
    font-size: 0.85rem;
    font-weight: 700;
    letter-spacing: 0.02em;
    margin-bottom: var(--space-3);
  }

  .footer-zone-note {
    font-size: 0.85rem;
    color: #C4B9AD;
    line-height: 1.5;
  }

  .schedule-card, .contact-card {
    background-color: #2E2925;
    border: 1px solid #3E3731;
    border-radius: var(--radius-md);
    padding: var(--space-3) var(--space-4);
    margin-bottom: var(--space-3);
  }

  .schedule-days, .schedule-hours {
    font-size: 0.875rem;
    color: #F5EFEB;
    margin-bottom: 2px;
  }

  .schedule-note {
    font-size: 0.8rem;
    color: #C4B9AD;
    margin-top: 4px;
  }

  .contact-label {
    font-size: 0.775rem;
    color: #C4B9AD;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .contact-val {
    font-size: 0.875rem;
    font-weight: 600;
    color: #25D366;
  }

  .footer-transparency {
    background-color: #28231F;
    border: 1px solid #3E3630;
    border-radius: var(--radius-lg);
    padding: var(--space-6);
    margin-bottom: var(--space-8);
  }

  .transparency-badge {
    display: inline-block;
    font-size: 0.75rem;
    font-weight: 700;
    color: #FDBA74;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: var(--space-2);
  }

  .footer-transparency p {
    font-size: 0.875rem;
    line-height: 1.6;
    color: #C4B9AD;
    max-width: 52ch;
  }

  .footer-bottom {
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-top: 1px solid #36302B;
    padding-top: var(--space-6);
    font-size: 0.85rem;
    color: #B5ABA0;
    flex-wrap: wrap;
    gap: var(--space-4);
  }

  .legal-links {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }

  .legal-links a {
    color: #C4B9AD;
    transition: color var(--transition-fast);
  }

  .legal-links a:hover {
    color: #FFFFFF;
  }

  .sep {
    color: #8C8276;
  }

  @media (max-width: 992px) {
    .footer-grid {
      grid-template-columns: 1fr 1fr;
      gap: var(--space-8);
    }
  }

  @media (max-width: 640px) {
    .footer-grid {
      grid-template-columns: 1fr;
      gap: var(--space-8);
    }
    .footer-bottom {
      flex-direction: column;
      text-align: center;
    }
  }
</style>
