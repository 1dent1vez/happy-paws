---
import { siteConfig } from '../config/site';
import WhatsAppButton from './WhatsAppButton.astro';
---

<footer class="site-footer">
  <div class="container">
    <div class="footer-grid">
      <!-- Col 1: Brand Info -->
      <div class="footer-col brand-col">
        <div class="footer-logo">
          <img
            src="/images/logo-mark.png"
            alt=""
            width="44"
            height="20"
            class="logo-img"
            aria-hidden="true"
          />
          <span class="footer-brand-name">Happy Paws</span>
        </div>
        <p class="footer-bio">
          Paseos al ritmo de tu perro, con recogida en tu puerta y reporte por WhatsApp. Exclusivo para la comunidad residencial de Foresta Dream Lagoons.
        </p>
        <div class="footer-cta-wrap">
          <WhatsAppButton
            context="general"
            text="Escríbenos por WhatsApp"
            size="sm"
            variant="whatsapp"
            id="footer-cta"
          />
          <a
            href={siteConfig.instagram.url}
            target="_blank"
            rel="noopener noreferrer"
            class="footer-insta-btn"
            aria-label="Síguenos en Instagram @happypawsmetepec"
          >
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect>
              <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path>
              <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line>
            </svg>
            <span>Instagram</span>
          </a>
        </div>
      </div>

      <!-- Col 2: Navigation Links -->
      <div class="footer-col">
        <h4 class="footer-heading">Navegación</h4>
        <ul class="footer-links">
          <li><a href="/">Inicio</a></li>
          <li><a href="/#paseos">Paseos y cuidado</a></li>
          <li><a href="/#como-funciona">Cómo Funciona</a></li>
          <li><a href="/#faq">Preguntas Frecuentes</a></li>
          <li><a href="/paseos/" class="sublanding-link">Paseos individuales y grupales</a></li>
        </ul>
      </div>

      <!-- Col 3: Exclusive Area -->
      <div class="footer-col">
        <h4 class="footer-heading">Zona Exclusiva</h4>
        <p class="footer-meta-text">
          {siteConfig.coverage.description} {siteConfig.coverage.city}, {siteConfig.coverage.state}.
        </p>
        <div class="exclusive-badge">
          <span>{siteConfig.coverage.community}</span>
        </div>
        <p class="footer-zone-note">
          Rutas dentro del fraccionamiento y sus áreas verdes para pasear en un entorno conocido.
        </p>
      </div>

      <!-- Col 4: Schedule & Attention -->
      <div class="footer-col">
        <h4 class="footer-heading">Horarios y Atención</h4>
        <div class="schedule-card">
          <p class="schedule-days"><strong>Días:</strong> {siteConfig.schedule.days}</p>
          <p class="schedule-hours"><strong>Horario:</strong> {siteConfig.schedule.hours}</p>
          <p class="schedule-note">{siteConfig.schedule.note}</p>
        </div>
        <div class="contact-card">
          <p class="contact-label">Canales directos:</p>
          <p class="contact-val">WhatsApp: {siteConfig.whatsapp.phoneFormatted}</p>
          <a
            href={siteConfig.instagram.url}
            target="_blank"
            rel="noopener noreferrer"
            class="contact-insta-row"
            aria-label="Instagram @happypawsmetepec"
          >
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect>
              <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path>
              <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line>
            </svg>
            <span>Instagram: {siteConfig.instagram.handle}</span>
          </a>
        </div>
      </div>
    </div>

    <!-- Transparency Disclaimer (No emojis) -->
    <div class="footer-transparency">
      <div class="transparency-badge">Compromiso de Honestidad y Cuidado Responsable</div>
      <p>
        Happy Paws es un servicio de paseo, recreación y bienestar canino al aire libre en Foresta Dream Lagoons. No ofrecemos diagnóstico veterinario ni modificación conductual clínica. Cada salida se realiza respetando las indicaciones de su familia y comunicando con total transparencia lo ocurrido.
      </p>
    </div>

    <!-- Bottom Bar -->
    <div class="footer-bottom">
      <p class="copyright">
        © {new Date().getFullYear()} Happy Paws. Todos los derechos reservados.
      </p>
      <div class="legal-links">
        <a href="/aviso-de-privacidad/">Aviso de Privacidad</a>
        <span class="sep">•</span>
        <a href="/terminos-del-servicio/">Términos del Servicio</a>
      </div>
    </div>
    <div class="footer-credit">
      <span>Hecho por</span>{' '}
      <a
        href="https://brilinr.dpdns.org/servicios/landing-page/"
        target="_blank"
        rel="noopener noreferrer"
        class="footer-credit-link"
        aria-label="Brilint (se abre en una pestaña nueva)"
      >Brilint</a>
    </div>
  </div>
</footer>

<style>
  .footer-cta-wrap :global(.btn-whatsapp) {
    background: transparent;
    border: 1px solid #786E63;
    color: #F4EEE6;
  }
  .footer-cta-wrap :global(.btn-whatsapp:hover) {
    background: #F4EEE6;
    color: #25231F;
  }

  .site-footer {
    background-color: #25231F;
    color: #E9E3DA;
    padding-top: var(--space-16);
    padding-bottom: var(--space-8);
    margin-top: auto;
    border-top: 1px solid #443E36;
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 1.4fr 1fr 1.3fr 1.3fr;
    gap: var(--space-10);
    margin-bottom: var(--space-12);
  }

  .brand-col {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .footer-logo {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }

  .logo-img {
    height: 30px;
    width: auto;
    flex-shrink: 0;
    object-fit: contain;
  }

  .footer-brand-name {
    font-size: 1.35rem;
    font-weight: 800;
    color: #FFFFFF;
    letter-spacing: -0.02em;
  }

  .site-footer p {
    color: #E9E3DA;
  }

  .footer-bio {
    font-size: 0.95rem;
    line-height: 1.6;
    color: #E9E3DA;
  }

  .footer-cta-wrap {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3);
    margin-top: var(--space-2);
  }

  .footer-insta-btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: #25231F;
    color: #E9E3DA;
    border: 1px solid #443E36;
    padding: 0.55rem 1.15rem;
    border-radius: var(--radius-full);
    font-size: 0.85rem;
    font-weight: 600;
    transition: all var(--transition-fast);
    text-decoration: none;
  }

  .footer-insta-btn:hover {
    background: #C9BEB1;
    color: #25231F;
    border-color: #C9BEB1;
    transform: translateY(-2px);
    box-shadow: 0 4px 14px rgba(109, 1, 1, 0.15);
  }

  .footer-heading {
    font-size: 0.95rem;
    font-weight: 700;
    color: #FFFFFF;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: var(--space-4);
  }

  .footer-links {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .footer-links a {
    color: #C9BEB1;
    font-size: 0.95rem;
    transition: color var(--transition-fast);
  }

  .footer-links a:hover {
    color: #C9BEB1;
  }

  .sublanding-link {
    font-size: 0.85rem !important;
    opacity: 0.85;
  }

  .footer-meta-text {
    font-size: 0.9rem;
    color: #E9E3DA;
    margin-bottom: var(--space-3);
  }

  .exclusive-badge {
    display: inline-block;
    background-color: #25231F;
    color: #C9BEB1;
    border: 1px solid #443E36;
    padding: 6px 14px;
    border-radius: var(--radius-md);
    font-size: 0.85rem;
    font-weight: 700;
    letter-spacing: 0.02em;
    margin-bottom: var(--space-3);
  }

  .footer-zone-note {
    font-size: 0.85rem;
    color: #C9BEB1;
    line-height: 1.5;
  }

  .schedule-card, .contact-card {
    background-color: #25231F;
    border: 1px solid #443E36;
    border-radius: var(--radius-md);
    padding: var(--space-3) var(--space-4);
    margin-bottom: var(--space-3);
  }

  .schedule-days, .schedule-hours {
    font-size: 0.875rem;
    color: #E9E3DA;
    margin-bottom: 2px;
  }

  .schedule-note {
    font-size: 0.8rem;
    color: #C9BEB1;
    margin-top: 4px;
  }

  .contact-label {
    font-size: 0.775rem;
    color: #C9BEB1;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .contact-val {
    font-size: 0.875rem;
    font-weight: 600;
    color: #E9E3DA;
  }

  .contact-insta-row {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 0.85rem;
    font-weight: 600;
    color: #C9BEB1;
    margin-top: 4px;
    text-decoration: none;
    transition: color var(--transition-fast);
  }

  .contact-insta-row:hover {
    color: #FFFFFF;
  }

  .footer-transparency {
    background-color: #25231F;
    border: 1px solid #443E36;
    border-radius: var(--radius-lg);
    padding: var(--space-6);
    margin-bottom: var(--space-8);
  }

  .transparency-badge {
    display: inline-block;
    font-size: 0.75rem;
    font-weight: 700;
    color: #C9BEB1;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: var(--space-2);
  }

  .footer-transparency p {
    font-size: 0.875rem;
    line-height: 1.6;
    color: #C9BEB1;
    max-width: 52ch;
  }

  .footer-bottom {
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-top: 1px solid #443E36;
    padding-top: var(--space-6);
    font-size: 0.85rem;
    color: #C9BEB1;
    flex-wrap: wrap;
    gap: var(--space-4);
  }

  .legal-links {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }

  .legal-links a {
    color: #C9BEB1;
    transition: color var(--transition-fast);
  }

  .legal-links a:hover {
    color: #FFFFFF;
  }

  .sep {
    color: #C9BEB1;
  }

  .footer-credit {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 0.25em;
    margin-top: 16px;
    /* Keep the signature clear of the existing floating WhatsApp CTA. */
    margin-bottom: calc(64px + env(safe-area-inset-bottom, 0px));
    color: #A5A8B1;
    font-size: 13px;
    font-weight: 400;
    line-height: 1.5;
    white-space: nowrap;
  }

  .footer-credit-link {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: #D4FF24;
    font-weight: 700;
    text-decoration: none;
  }

  .footer-credit-link:hover,
  .footer-credit-link:focus {
    color: #D4FF24;
    text-decoration: underline;
  }

  .footer-credit-link:focus-visible {
    outline: 2px solid #D4FF24;
    outline-offset: 3px;
  }

  @media (max-width: 992px) {
    .footer-grid {
      grid-template-columns: 1fr 1fr;
      gap: var(--space-8);
    }
  }

  @media (max-width: 640px) {
    .footer-grid {
      grid-template-columns: 1fr;
      gap: var(--space-8);
    }
    .footer-bottom {
      flex-direction: column;
      text-align: center;
    }
    .footer-credit {
      justify-content: center;
    }
  }
</style>
