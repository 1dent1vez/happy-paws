---
import { faqs } from '../config/faqs';
---

<div class="faq-accordion" id="faq-list">
  {faqs.map((faq, index) => (
    <details class="faq-item" id={`faq-${index + 1}`}>
      <summary class="faq-question">
        <span>{faq.question}</span>
        <span class="faq-icon-wrap" aria-hidden="true">
          <svg class="faq-icon-toggle" width="20" height="20" viewBox="0 0 24 24" fill="none">
            <path class="icon-line-h" d="M5 12H19" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"/>
            <path class="icon-line-v" d="M12 5V19" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"/>
          </svg>
        </span>
      </summary>
      <div class="faq-answer">
        <p>{faq.answer}</p>
      </div>
    </details>
  ))}
</div>

<style>
  .faq-accordion {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    max-width: 860px;
    margin: 0 auto;
  }

  .faq-item {
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    overflow: hidden;
    transition: border-color var(--transition-fast), box-shadow var(--transition-fast), transform var(--transition-fast);
  }

  .faq-item:hover {
    border-color: var(--color-border-strong);
    box-shadow: var(--shadow-sm);
  }

  .faq-item[open] {
    border-color: var(--color-primary-border);
    box-shadow: var(--shadow-md);
  }

  .faq-question {
    padding: var(--space-5) var(--space-6);
    font-size: 1.05rem;
    font-weight: 700;
    color: var(--color-text-title);
    cursor: pointer;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-4);
    list-style: none;
    user-select: none;
    transition: color var(--transition-fast);
  }

  .faq-question::-webkit-details-marker {
    display: none;
  }

  .faq-question:hover {
    color: var(--color-primary-action);
  }

  .faq-icon-wrap {
    flex-shrink: 0;
    width: 30px;
    height: 30px;
    border-radius: 50%;
    background-color: var(--color-primary-light);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-primary-action);
    transition: background-color var(--transition-fast), color var(--transition-fast), transform var(--transition-fast);
  }

  .faq-icon-toggle {
    transition: transform var(--transition-normal);
  }

  .icon-line-v {
    transition: opacity var(--transition-fast), transform var(--transition-fast);
    transform-origin: center;
  }

  .faq-item[open] .icon-line-v {
    opacity: 0;
    transform: rotate(90deg);
  }

  .faq-item[open] .faq-icon-wrap {
    background-color: var(--color-primary-action);
    color: #FFFFFF;
    transform: rotate(90deg);
  }

  .faq-answer {
    padding: 0 var(--space-6) var(--space-6) var(--space-6);
    color: var(--color-text-muted);
    font-size: 0.975rem;
    line-height: 1.65;
    border-top: 1px solid var(--color-border-subtle);
    padding-top: var(--space-4);
  }

  .faq-answer p {
    margin: 0;
    max-width: 72ch;
  }

  @media (max-width: 640px) {
    .faq-question {
      padding: var(--space-4);
      font-size: 0.975rem;
      gap: var(--space-3);
    }

    .faq-icon-wrap {
      width: 32px;
      height: 32px;
    }

    .faq-answer {
      padding: 0 var(--space-4) var(--space-4) var(--space-4);
      font-size: 0.925rem;
    }
  }
</style>
