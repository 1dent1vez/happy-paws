---
interface FAQItem {
  question: string;
  answer: string;
}

const faqs: FAQItem[] = [
  {
    question: '¿El servicio opera exclusivamente dentro de Foresta Dream Lagoons?',
    answer: 'Sí. Nos enfocamos exclusivamente en Foresta Dream Lagoons. Esto nos permite garantizar máxima puntualidad, conocimiento profundo de las áreas verdes y senderos más seguros del fraccionamiento, y atención vecinal cercana y confiable.'
  },
  {
    question: '¿Cuánto tiempo dura cada paseo?',
    answer: 'Nuestros paseos tienen una duración efectiva de 45 a 60 minutos de caminata y estimulación olfativa dentro de Foresta, adaptados a la edad, condición física y nivel de energía de tu perro.'
  },
  {
    question: '¿En qué horarios realizan las salidas?',
    answer: 'Operamos de lunes a sábado entre las 7:00 y las 19:00 hrs. Los paseos se programan con antelación en franjas convenientes para evitar las horas de mayor radiación solar y cuidar sus almohadillas.'
  },
  {
    question: '¿Cómo eligen entre paseo individual o grupal?',
    answer: 'En la charla inicial de conocimiento evaluamos la personalidad de tu mascota. Si es tímido, de edad avanzada o prefiere no convivir con otros perros, recomendamos paseo individual. Si es sociable y equilibrado, puede integrarse a un grupo pequeño de máximo 3 a 4 perros con temperamentos compatibles.'
  },
  {
    question: '¿Qué información solicitan antes del primer paseo?',
    answer: 'Solicitamos esquema de vacunación básico al día, uso de arnés o pechera ergonómica en buen estado, datos de contacto de emergencia y cualquier observación relevante sobre su comportamiento (reacción a estímulos, hábitos o alergias).'
  },
  {
    question: '¿Qué sucede si llueve o hay clima adverso en Foresta?',
    answer: 'La seguridad y bienestar de tu perro son prioridad. Ante lluvia intensa o tormenta, pausamos el recorrido en zonas cubiertas o coordinamos contigo por WhatsApp el reagendamiento o reposición del tiempo.'
  },
  {
    question: '¿Cómo solicito disponibilidad o cotización?',
    answer: 'Solo debes pulsar cualquiera de nuestros botones de WhatsApp. Te responderemos directamente para conocer a tu perrito, resolver dudas y acordar los días y horarios que necesitas.'
  }
];
---

<div class="faq-accordion" id="faq-list">
  {faqs.map((faq, index) => (
    <details class="faq-item" id={`faq-${index + 1}`}>
      <summary class="faq-question">
        <span>{faq.question}</span>
        <span class="faq-icon-wrap" aria-hidden="true">
          <svg class="faq-icon-toggle" width="20" height="20" viewBox="0 0 24 24" fill="none">
            <path class="icon-line-h" d="M5 12H19" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"/>
            <path class="icon-line-v" d="M12 5V19" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"/>
          </svg>
        </span>
      </summary>
      <div class="faq-answer">
        <p>{faq.answer}</p>
      </div>
    </details>
  ))}
</div>

<style>
  .faq-accordion {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    max-width: 860px;
    margin: 0 auto;
  }

  .faq-item {
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    overflow: hidden;
    transition: border-color var(--transition-fast), box-shadow var(--transition-fast);
  }

  .faq-item[open] {
    border-color: var(--color-primary-border);
    box-shadow: var(--shadow-sm);
  }

  .faq-question {
    padding: var(--space-5) var(--space-6);
    font-size: 1.05rem;
    font-weight: 700;
    color: var(--color-text-title);
    cursor: pointer;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-4);
    list-style: none;
    user-select: none;
  }

  .faq-question::-webkit-details-marker {
    display: none;
  }

  .faq-question:hover {
    color: var(--color-primary);
  }

  .faq-icon-wrap {
    flex-shrink: 0;
    width: 28px;
    height: 28px;
    border-radius: 50%;
    background-color: var(--color-primary-light);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-primary);
    transition: transform var(--transition-fast);
  }

  .faq-icon-toggle {
    transition: transform var(--transition-normal);
  }

  .icon-line-v {
    transition: opacity var(--transition-fast), transform var(--transition-fast);
    transform-origin: center;
  }

  .faq-item[open] .icon-line-v {
    opacity: 0;
    transform: rotate(90deg);
  }

  .faq-item[open] .faq-icon-wrap {
    background-color: var(--color-primary);
    color: #FFFFFF;
  }

  .faq-answer {
    padding: 0 var(--space-6) var(--space-6) var(--space-6);
    color: var(--color-text-muted);
    font-size: 0.975rem;
    line-height: 1.65;
    border-top: 1px solid var(--color-border-subtle);
    padding-top: var(--space-4);
  }

  .faq-answer p {
    margin: 0;
  }
</style>
