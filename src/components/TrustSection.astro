---
interface Props {
  showTitle?: boolean;
}

const { showTitle = true } = Astro.props;

const trustPillars = [
  {
    iconSvg: `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path></svg>`,
    title: 'Manejo Responsable y Respetuoso',
    description: 'Paseamos con correas fijas y arnés ergonómico provisto por la familia. Cero tirones bruscos, sin collares de castigo ni jalones innecesarios.'
  },
  {
    iconSvg: `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>`,
    title: 'Puntualidad en tu Puerta',
    description: 'Te avisamos por WhatsApp al momento de llegar a tu domicilio en Foresta y cuando regresamos a tu perro sano, relajado y feliz.'
  },
  {
    iconSvg: `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2a10 10 0 1 0 10 10H12V2z"></path></svg>`,
    title: 'Exploración y Estimulación Mental',
    description: 'El olfato es clave para el bienestar canino. Permitimos que huela y descubra los senderos sin prisa, reduciendo el estrés acumulado.'
  },
  {
    iconSvg: `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><path d="M23 21v-2a4 4 0 0 0-3-3.87"></path><path d="M16 3.13a4 4 0 0 1 0 7.75"></path></svg>`,
    title: 'Grupos Pequeños y Compatibles',
    description: 'Para paseos grupales nunca saturamos el grupo (máximo 3-4 perros) y evaluamos previamente el temperamento y energía de cada uno.'
  },
  {
    iconSvg: `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path></svg>`,
    title: 'Comunicación Directa y Honesta',
    description: 'Si tu perro muestra cansancio, rechazo a caminar o cualquier cambio en su ánimo, te lo comunicamos de inmediato sin ocultar nada.'
  },
  {
    iconSvg: `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline></svg>`,
    title: 'Ficha Individual de Cada Perro',
    description: 'Registramos sus gustos, miedos cotidianos (como ruidos fuertes o motos), alergias e instrucciones específicas de su familia.'
  }
];
---

<section class="section-wrapper" id="confianza">
  <div class="container">
    {showTitle && (
      <div class="section-header">
        <span class="badge badge-orange">Confianza y Tranquilidad</span>
        <h2>Tu tranquilidad y el bienestar de tu perro son nuestra prioridad</h2>
        <p>
          No improvisamos con quien más quieres. Establecemos un estándar de cuidado claro, transparente y comprobable en Foresta Dream Lagoons.
        </p>
      </div>
    )}

    <div class="grid-3">
      {trustPillars.map((pillar) => (
        <div class="card trust-card">
          <div class="trust-icon" aria-hidden="true" set:html={pillar.iconSvg} />
          <h3 class="trust-title">{pillar.title}</h3>
          <p class="trust-desc">{pillar.description}</p>
        </div>
      ))}
    </div>

    <!-- Trust banner disclaimer of real capabilities (zero emojis) -->
    <div class="service-standard-banner">
      <div class="standard-icon">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
          <polyline points="20 6 9 17 4 12"></polyline>
        </svg>
      </div>
      <div class="standard-text">
        <h4>Compromiso de Realidad y Honestidad Comercial</h4>
        <p>
          En Happy Paws solo ofrecemos compromisos que podemos cumplir. No inventamos certificaciones médicas, no somos hospital veterinario ni ofrecemos modificación conductual garantizada. Ofrecemos paseadores atentos, amables, responsables y un servicio consistente con comunicación en tiempo real en Foresta Dream Lagoons.
        </p>
      </div>
    </div>
  </div>
</section>

<style>
  .trust-card {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    background-color: var(--color-surface);
  }

  .trust-icon {
    width: 48px;
    height: 48px;
    background-color: var(--color-primary-light);
    color: var(--color-primary);
    border-radius: var(--radius-lg);
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: var(--space-2);
  }

  .trust-title {
    font-size: 1.2rem;
    color: var(--color-text-title);
  }

  .trust-desc {
    font-size: 0.925rem;
    line-height: 1.6;
    color: var(--color-text-muted);
  }

  .service-standard-banner {
    margin-top: var(--space-12);
    background-color: var(--color-primary-light);
    border: 1px solid var(--color-primary-border);
    border-radius: var(--radius-xl);
    padding: var(--space-6) var(--space-8);
    display: flex;
    gap: var(--space-5);
    align-items: flex-start;
  }

  .standard-icon {
    background: #fff;
    color: var(--color-primary);
    width: 44px;
    height: 44px;
    border-radius: var(--radius-md);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .standard-text h4 {
    font-size: 1.05rem;
    color: var(--color-primary-hover);
    margin-bottom: var(--space-1);
  }

  .standard-text p {
    font-size: 0.925rem;
    line-height: 1.55;
    color: var(--color-text);
  }

  @media (max-width: 640px) {
    .service-standard-banner {
      flex-direction: column;
      padding: var(--space-6);
    }
  }
</style>
