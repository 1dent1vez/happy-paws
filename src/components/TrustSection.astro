---
interface Props {
  showTitle?: boolean;
}

const { showTitle = true } = Astro.props;

const trustPillars = [
  {
    icon: '🛡️',
    title: 'Manejo Responsable y Respetuoso',
    description: 'Paseamos con correas fijas y arnés ergonómico provisto por la familia. Cero tirones bruscos, sin collares de castigo ni jalones innecesarios.'
  },
  {
    icon: '📍',
    title: 'Puntualidad y Confirmación en Puerta',
    description: 'Te avisamos por WhatsApp al momento de llegar a tu domicilio y cuando regresamos a tu perro sano, seguro y relajado.'
  },
  {
    icon: '🌿',
    title: 'Exploración y Estimulación Mental',
    description: 'El olfato es clave para el bienestar canino. Permitimos que huela y descubra su entorno sin prisa, reduciendo el estrés acumulado.'
  },
  {
    icon: '👥',
    title: 'Grupos Pequeños y Compatibles',
    description: 'Para paseos grupales nunca saturamos el grupo (máximo 3-4 perros) y evaluamos previamente el temperamento y energía de cada uno.'
  },
  {
    icon: '💬',
    title: 'Comunicación Directa y Honesta',
    description: 'Si tu perro muestra cansancio, rechazo a caminar o cualquier cambio en su ánimo, te lo comunicamos de inmediato sin ocultar nada.'
  },
  {
    icon: '📋',
    title: 'Ficha Individual de Cada Perro',
    description: 'Registramos sus gustos, miedos cotidianos (como motos o truenos), alergias e instrucciones específicas de su familia humana.'
  }
];
---

<section class="section-wrapper" id="confianza">
  <div class="container">
    {showTitle && (
      <div class="section-header">
        <span class="badge badge-orange">Por Qué Confiar en Happy Paws</span>
        <h2>Tu tranquilidad y el bienestar de tu perro son nuestra prioridad</h2>
        <p>
          No improvisamos con quien más quieres. Establecemos un estándar de cuidado claro, transparente y comprobable en cada salida.
        </p>
      </div>
    )}

    <div class="grid-3">
      {trustPillars.map((pillar) => (
        <div class="card trust-card">
          <div class="trust-icon" aria-hidden="true">{pillar.icon}</div>
          <h3 class="trust-title">{pillar.title}</h3>
          <p class="trust-desc">{pillar.description}</p>
        </div>
      ))}
    </div>

    <!-- Trust banner disclaimer of real capabilities -->
    <div class="service-standard-banner">
      <div class="standard-icon">✅</div>
      <div class="standard-text">
        <h4>Compromiso de Realidad y Honestidad Comercial</h4>
        <p>
          En Happy Paws solo ofrecemos compromisos que podemos cumplir. No inventamos certificaciones médicas, no somos hospital veterinario ni ofrecemos modificación conductual garantizada. Ofrecemos paseadores atentos, amables, responsables y un servicio consistente con comunicación en tiempo real.
        </p>
      </div>
    </div>
  </div>
</section>

<style>
  .trust-card {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    background-color: var(--color-surface);
  }

  .trust-icon {
    font-size: 2rem;
    width: 52px;
    height: 52px;
    background-color: var(--color-primary-light);
    border-radius: var(--radius-lg);
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: var(--space-2);
  }

  .trust-title {
    font-size: 1.2rem;
    color: var(--color-text-title);
  }

  .trust-desc {
    font-size: 0.925rem;
    line-height: 1.6;
    color: var(--color-text-muted);
  }

  .service-standard-banner {
    margin-top: var(--space-12);
    background-color: var(--color-primary-light);
    border: 1px solid var(--color-primary-border);
    border-radius: var(--radius-xl);
    padding: var(--space-6) var(--space-8);
    display: flex;
    gap: var(--space-5);
    align-items: flex-start;
  }

  .standard-icon {
    font-size: 1.75rem;
    background: #fff;
    width: 44px;
    height: 44px;
    border-radius: var(--radius-md);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .standard-text h4 {
    font-size: 1.05rem;
    color: var(--color-primary-hover);
    margin-bottom: var(--space-1);
  }

  .standard-text p {
    font-size: 0.925rem;
    line-height: 1.55;
    color: var(--color-text);
  }

  @media (max-width: 640px) {
    .service-standard-banner {
      flex-direction: column;
      padding: var(--space-6);
    }
  }
</style>
