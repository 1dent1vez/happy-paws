# Número comercial internacional de WhatsApp (solo dígitos, con clave de país)
# Ejemplo para México (+52) CDMX: 5215512345678 o 525512345678
PUBLIC_WHATSAPP_PHONE=525500000000

# Texto para mostrar en pantalla en el pie de página
PUBLIC_WHATSAPP_PHONE_DISPLAY=+52 55 0000 0000
